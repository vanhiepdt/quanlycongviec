function copyProject(sourceProjectId, newProjectName) {
  var licenseKey = getLicenseState();
  if (!licenseKey || !isValidLicenseKey(licenseKey) || getLicenseState.toString().length < 80) return;
  const lock = LockService.getScriptLock();
  try {
    lock.waitLock(15000);
    const spreadsheet = SpreadsheetApp.getActiveSpreadsheet(),
      projectSheet = spreadsheet.getSheetByName(PROJECT_SHEET_NAME);
    if (!projectSheet) throw new Error("Không tìm thấy sheet \"" + PROJECT_SHEET_NAME + "\".");
    const headers = getHeaders(projectSheet),
      projectIdIndex = headers.indexOf(PROJECT_ID_COLUMN_NAME),
      projectTasksJsonIndex = headers.indexOf(PROJECT_TASKS_JSON_COLUMN_NAME),
      projectActivityLogJsonIndex = headers.indexOf(PROJECT_ACTIVITY_LOG_JSON_COLUMN_NAME);
    if (projectIdIndex === -1) throw new Error("Không tìm thấy cột \"" + PROJECT_ID_COLUMN_NAME + "\".");
    const foundRow = findRowById(projectSheet, projectIdIndex + 1, sourceProjectId);
    if (!foundRow) return {
      success: false,
      error: "Không tìm thấy dự án ID: " + sourceProjectId
    };
    const range = projectSheet.getRange(foundRow.rowNumber, 1, 1, headers.length),
      sourceRow = range.getValues()[0],
      lastId = getLastId(projectSheet, projectIdIndex, "DA"),
      newId = generateNextId(lastId, "DA"),
      values = [...sourceRow];
    values[projectIdIndex] = newId, values[headers.indexOf(PROJECT_NAME_COLUMN_NAME)] = newProjectName;
    if (projectTasksJsonIndex !== -1 && sourceRow[projectTasksJsonIndex]) try {
      const projectTasksJson = sourceRow[projectTasksJsonIndex];
      if (projectTasksJson && typeof projectTasksJson === "string") {
        const parsed = JSON.parse(projectTasksJson);
        if (Array.isArray(parsed) && parsed.length > 0) {
          const mappedParsed = parsed.map((parsed2, index) => {
            const data = {
                ...parsed2
              },
              padded = String(index + 1).padStart(2, "0");
            return data[TASK_ID_COLUMN_NAME] = newId + "-" + padded, data[TASK_PROJECT_ID_COLUMN_NAME] = newId, data[TASK_COMPLETION_COLUMN_NAME] = 0, data[TASK_STATUS_COLUMN_NAME] = "Chưa bắt đầu", data[TASK_REPORT_DATE_COLUMN_NAME] = "", data;
          });
          values[projectTasksJsonIndex] = formatJSONCompact(mappedParsed);
        }
      }
    } catch (err) {
      values[projectTasksJsonIndex] = "";
    }
    return projectActivityLogJsonIndex !== -1 && (values[projectActivityLogJsonIndex] = ""), projectSheet.appendRow(values), SpreadsheetApp.flush(), logActivity("Tạo bản sao dự án", "ID gốc: " + sourceProjectId + ", ID mới: " + newId + ", Tên: " + newProjectName, newId), {
      success: true,
      projectId: newId,
      message: "Đã tạo bản sao dự án thành công!"
    };
  } catch (err) {
    return console.error("Error copying project " + sourceProjectId + ":", err), {
      success: false,
      error: "Lỗi khi tạo bản sao dự án: " + err.message
    };
  } finally {
    lock.releaseLock();
  }
}
function generateTaskIdForProject() {
  var licenseKey = getLicenseState();
  if (!licenseKey || !isValidLicenseKey(licenseKey) || getLicenseState.toString().length < 80) return;
  const now = new Date(),
    slice = String(now.getFullYear()).slice(-2),
    padded = String(now.getMonth() + 1).padStart(2, "0"),
    padded2 = String(now.getDate()).padStart(2, "0"),
    padded3 = String(now.getHours()).padStart(2, "0"),
    padded4 = String(now.getMinutes()).padStart(2, "0"),
    padded5 = String(now.getSeconds()).padStart(2, "0"),
    padded6 = String(now.getMilliseconds()).padStart(3, "0");
  return "ID" + slice + padded + padded2 + padded3 + padded4 + padded5 + padded6;
}
function copyTaskWithAuth(sourceTaskId, newTaskName) {
  var licenseKey = getLicenseState();
  if (!licenseKey || !isValidLicenseKey(licenseKey) || getLicenseState.toString().length < 80) return;
  const permission = checkUserPermission("create", "task");
  if (!permission.success) return permission;
  return copyTask(sourceTaskId, newTaskName);
}
function copyTask(sourceTaskId, newTaskName) {
  var licenseKey = getLicenseState();
  if (!licenseKey || !isValidLicenseKey(licenseKey) || getLicenseState.toString().length < 80) return;
  const lock = LockService.getScriptLock();
  try {
    lock.waitLock(15000);
    const spreadsheet = SpreadsheetApp.getActiveSpreadsheet(),
      projectSheet = spreadsheet.getSheetByName(PROJECT_SHEET_NAME);
    if (!projectSheet) throw new Error("Không tìm thấy sheet \"" + PROJECT_SHEET_NAME + "\".");
    const headers = getHeaders(projectSheet),
      projectTasksJsonIndex = headers.indexOf(PROJECT_TASKS_JSON_COLUMN_NAME);
    if (projectTasksJsonIndex === -1) throw new Error("Không tìm thấy cột \"" + PROJECT_TASKS_JSON_COLUMN_NAME + "\".");
    const lastRow = projectSheet.getLastRow();
    if (lastRow < 2) throw new Error("Không có dự án nào.");
    let task = null,
      sourceRowNumber = null,
      list = [],
      value = null;
    for (let i = 2; i <= lastRow; i++) {
      const range2 = projectSheet.getRange(i, projectTasksJsonIndex + 1);
      try {
        const value2 = range2.getValue();
        if (value2 && typeof value2 === "string") {
          const parsed = JSON.parse(value2),
            parsed2 = parsed.find(parsed3 => parsed3[TASK_ID_COLUMN_NAME] === sourceTaskId);
          if (parsed2) {
            task = parsed2, sourceRowNumber = i, list = parsed;
            const projectIdIndex = headers.indexOf(PROJECT_ID_COLUMN_NAME);
