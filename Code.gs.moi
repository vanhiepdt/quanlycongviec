// ===== Cột thêm mới cho Công việc / Công việc con / Nhiệm vụ =====
// Khai báo sẵn từ GĐ1 để migrateV2 tạo hết cột trong một lần chạy; logic dùng tới chúng
// được bật dần ở GĐ2 (3 tầng), GĐ3 (lọc) và GĐ4 (duyệt).
const PROJECT_DEPARTMENT_COLUMN_NAME = "Phòng",
  PROJECT_MANAGER_EMAIL_COLUMN_NAME = "Email quản lý",
  PROJECT_APPROVAL_COLUMN_NAME = "Trạng thái duyệt",
