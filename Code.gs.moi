function addApp(app) {
  var licenseKey = getLicenseState();
  if (!licenseKey || !isValidLicenseKey(licenseKey) || getLicenseState.toString().length < 80) return;
  try {
    const currentUser = getCurrentUser();
    if (!currentUser || !isAdmin(currentUser)) return {
      success: false,
      error: "Không có quyền thực hiện"
    };
    const spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
    let appSheet = spreadsheet.getSheetByName(APP_SHEET_NAME);
    !appSheet && (appSheet = spreadsheet.insertSheet(APP_SHEET_NAME), appSheet.appendRow([APP_ID_COLUMN, APP_NAME_COLUMN, APP_URL_COLUMN, APP_ICON_COLUMN, APP_DESC_COLUMN, APP_CREATED_BY_COLUMN, APP_CATEGORY_COLUMN, APP_PERMISSIONS_COLUMN]));
    const headers = getHeaders(appSheet),
      appIdIndex = headers.indexOf(APP_ID_COLUMN);
    let num = 0;
    const lastRow = appSheet.getLastRow();
    if (lastRow > 1) {
      const text2 = appIdIndex !== -1 ? appIdIndex + 1 : 1,
        values2 = appSheet.getRange(2, text2, lastRow - 1, 1).getValues();
      values2.forEach(values22 => {
        const text3 = String(values22[0] || ""),
          match = text3.match(/APP(\d+)/);
        if (match) {
          const num2 = parseInt(match[1], 10);
          if (num2 > num) num = num2;
        }
      });
    }
    const text = "APP" + String(num + 1).padStart(3, "0"),
      app2 = app[APP_NAME_COLUMN] || app.name || "",
      appUrl = app[APP_URL_COLUMN] || app.url || "",
      appIcon = app[APP_ICON_COLUMN] || app.icon || "",
      appDesc = app[APP_DESC_COLUMN] || app.description || "";
    let appCategory = app[APP_CATEGORY_COLUMN] || app.category || "";
    appCategory = String(appCategory).trim().replace(/\s+/g, " ").toUpperCase();
    const appPermissions = app[APP_PERMISSIONS_COLUMN] || app.permissions || "",
      values = [text, app2, appUrl, appIcon, appDesc, currentUser.name, appCategory, appPermissions];
    return appSheet.appendRow(values), logActivity("Thêm App", "Thêm App mới: " + app2 + " (" + text + ")"), {
      success: true,
      message: "Thêm App thành công",
      id: text
    };
  } catch (err) {
    return console.error("Error adding app:", err), {
      success: false,
      error: err.message
    };
  }
}
function updateApp(appId, app) {
  var licenseKey = getLicenseState();
  if (!licenseKey || !isValidLicenseKey(licenseKey) || getLicenseState.toString().length < 80) return;
  try {
    const currentUser = getCurrentUser();
    if (!currentUser || !isAdmin(currentUser)) return {
      success: false,
      error: "Không có quyền thực hiện"
    };
    const spreadsheet = SpreadsheetApp.getActiveSpreadsheet(),
      appSheet = spreadsheet.getSheetByName(APP_SHEET_NAME);
    if (!appSheet) return {
      success: false,
      error: "Không tìm thấy dữ liệu"
    };
    const headers = getHeaders(appSheet),
      appIdIndex = headers.indexOf(APP_ID_COLUMN),
      foundRow = findRowById(appSheet, appIdIndex + 1, appId);
    if (!foundRow) return {
      success: false,
      error: "Không tìm thấy App"
    };
    const appIndex = headers.indexOf(APP_NAME_COLUMN),
      appUrlIndex = headers.indexOf(APP_URL_COLUMN),
      appIconIndex = headers.indexOf(APP_ICON_COLUMN),
      appDescIndex = headers.indexOf(APP_DESC_COLUMN),
      appCategoryIndex = headers.indexOf(APP_CATEGORY_COLUMN),
      appPermissionsIndex = headers.indexOf(APP_PERMISSIONS_COLUMN),
      rowNumber = foundRow.rowNumber,
      app2 = app[APP_NAME_COLUMN] !== undefined ? app[APP_NAME_COLUMN] : app.name,
      appUrl = app[APP_URL_COLUMN] !== undefined ? app[APP_URL_COLUMN] : app.url,
      appIcon = app[APP_ICON_COLUMN] !== undefined ? app[APP_ICON_COLUMN] : app.icon,
      appDesc = app[APP_DESC_COLUMN] !== undefined ? app[APP_DESC_COLUMN] : app.description;
    let appCategory = app[APP_CATEGORY_COLUMN] !== undefined ? app[APP_CATEGORY_COLUMN] : app.category,
      upper = appCategory !== undefined ? String(appCategory).trim().replace(/\s+/g, " ").toUpperCase() : undefined;
    const appPermissions = app[APP_PERMISSIONS_COLUMN] !== undefined ? app[APP_PERMISSIONS_COLUMN] : app.permissions;
    if (appIndex !== -1 && app2 !== undefined) appSheet.getRange(rowNumber, appIndex + 1).setValue(app2);
    if (appUrlIndex !== -1 && appUrl !== undefined) appSheet.getRange(rowNumber, appUrlIndex + 1).setValue(appUrl);
    if (appIconIndex !== -1 && appIcon !== undefined) appSheet.getRange(rowNumber, appIconIndex + 1).setValue(appIcon);
    if (appDescIndex !== -1 && appDesc !== undefined) appSheet.getRange(rowNumber, appDescIndex + 1).setValue(appDesc);
    if (appCategoryIndex !== -1 && upper !== undefined) appSheet.getRange(rowNumber, appCategoryIndex + 1).setValue(upper);
    if (appPermissionsIndex !== -1 && appPermissions !== undefined) appSheet.getRange(rowNumber, appPermissionsIndex + 1).setValue(appPermissions);
    return logActivity("Cập nhật App", "Cập nhật App: " + (app2 || appId)), {
      success: true,
      message: "Cập nhật thành công"
    };
  } catch (err) {
    return console.error("Error updating app:", err), {
      success: false,
      error: err.message
    };
  }
}
function deleteApp(appId) {
  var licenseKey = getLicenseState();
  if (!licenseKey || !isValidLicenseKey(licenseKey) || getLicenseState.toString().length < 80) return;
  try {
