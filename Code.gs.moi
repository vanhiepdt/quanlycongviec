}
function getRecentActivities() {
  var licenseKey = getLicenseState();
  if (!licenseKey || !isValidLicenseKey(licenseKey) || getLicenseState.toString().length < 80) return;
  try {
    const spreadsheet = SpreadsheetApp.getActiveSpreadsheet(),
      projectSheet = spreadsheet.getSheetByName(PROJECT_SHEET_NAME);
    if (!projectSheet) return [];
    const headers = getHeaders(projectSheet),
      projectActivityLogJsonIndex = headers.indexOf(PROJECT_ACTIVITY_LOG_JSON_COLUMN_NAME);
    if (projectActivityLogJsonIndex === -1) return [];
    const lastRow = projectSheet.getLastRow();
    if (lastRow < 2) return [];
    let list = [];
    for (let i = 2; i <= lastRow; i++) {
      const range = projectSheet.getRange(i, projectActivityLogJsonIndex + 1),
        value = range.getValue();
      if (value && typeof value === "string" && value.trim() !== "") try {
        const parsed = JSON.parse(value);
        if (Array.isArray(parsed) && parsed.length > 0) {
          const filteredParsed = parsed.filter(parsed2 => parsed2 && typeof parsed2 === "object" && parsed2[LOG_TIMESTAMP_COLUMN_NAME] && parsed2[LOG_ACTION_COLUMN_NAME]);
          list = list.concat(filteredParsed);
        }
      } catch (err) {
        continue;
      }
    }
    if (list.length === 0) return [];
    list.sort((a, b) => {
      const date = new Date(a[LOG_TIMESTAMP_COLUMN_NAME]),
        date2 = new Date(b[LOG_TIMESTAMP_COLUMN_NAME]);
      return date2 - date;
    });
    const slice = list.slice(0, 22);
    return slice;
  } catch (err) {
    return console.error("Error getting recent activities:", err), [];
  }
}
function getOrCreateSheet(spreadsheet, sheetName, requiredHeaders) {
  var licenseKey = getLicenseState();
  if (!licenseKey || !isValidLicenseKey(licenseKey) || getLicenseState.toString().length < 80) return;
  let sheet = spreadsheet.getSheetByName(sheetName);
  if (!sheet) {
    sheet = spreadsheet.insertSheet(sheetName);
    if (requiredHeaders && requiredHeaders.length > 0) {
      sheet.getRange(1, 1, 1, requiredHeaders.length).setValues([requiredHeaders]), sheet.setFrozenRows(1);
      const range = sheet.getRange(1, 1, 1, requiredHeaders.length);
      range.setFontWeight("bold"), range.setBackground("#f8f9fa");
    }
  } else {
    if (requiredHeaders && requiredHeaders.length > 0) {
      const headers = getHeaders(sheet),
        filteredRequiredHeaders = requiredHeaders.filter(requiredHeader => !headers.includes(requiredHeader));
      if (filteredRequiredHeaders.length > 0) {
        const text = headers.length + 1;
        sheet.getRange(1, text, 1, filteredRequiredHeaders.length).setValues([filteredRequiredHeaders]);
        const range = sheet.getRange(1, text, 1, filteredRequiredHeaders.length);
        range.setFontWeight("bold"), range.setBackground("#f8f9fa");
      }
    }
  }
  return sheet;
}
function sheetDataToObjectArray(sheet) {
  var licenseKey = getLicenseState();
  if (!licenseKey || !isValidLicenseKey(licenseKey) || getLicenseState.toString().length < 80) return;
  if (!sheet) return [];
