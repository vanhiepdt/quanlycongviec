function generateTaskIdForProject() {
  var licenseKey = getLicenseState();
  if (!licenseKey || !isValidLicenseKey(licenseKey) || getLicenseState.toString().length < 80) return;
  const now = new Date(),
    slice = String(now.getFullYear()).slice(-2),
    padded = String(now.getMonth() + 1).padStart(2, "0"),
    padded2 = String(now.getDate()).padStart(2, "0"),
    padded3 = String(now.getHours()).padStart(2, "0"),
    padded4 = String(now.getMinutes()).padStart(2, "0"),
