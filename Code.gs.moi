    const spreadsheet = SpreadsheetApp.getActiveSpreadsheet(),
      chatSheet = getOrCreateSheet(spreadsheet, CHAT_SHEET_NAME, [CHAT_ID_COLUMN_NAME, CHAT_DATE_COLUMN_NAME, CHAT_JSON_COLUMN_NAME]),
      todayKey = new Date().toDateString(),
      headers = getHeaders(chatSheet),
      chatIdIndex = headers.indexOf(CHAT_ID_COLUMN_NAME),
      chatDateIndex = headers.indexOf(CHAT_DATE_COLUMN_NAME),
      chatJsonIndex = headers.indexOf(CHAT_JSON_COLUMN_NAME),
      lastRow = chatSheet.getLastRow();
    let lastRow2 = null,
      list = [];
    if (lastRow >= 2) {
      const value = chatSheet.getRange(lastRow, chatDateIndex + 1).getValue();
      if (new Date(value).toDateString() === todayKey) {
        lastRow2 = lastRow;
        const value2 = chatSheet.getRange(lastRow, chatJsonIndex + 1).getValue();
        value2 && typeof value2 === "string" && (list = JSON.parse(value2));
      }
    }
    const padded = String(list.length + 1).padStart(3, "0"),
      now = new Date(),
      text = String(now.getHours()).padStart(2, "0") + ":" + String(now.getMinutes()).padStart(2, "0"),
      data = {
        id: padded,
        user: currentUser.name,
        message: messageText,
        timestamp: text,
        avatar: currentUser.name.split(" ").map(item => item[0]).join("").toUpperCase().slice(0, 2)
      };
    list.push(data);
    list.length > 100 && (list = list.slice(-100));
    if (lastRow2) chatSheet.getRange(lastRow2, chatJsonIndex + 1).setValue(formatChatJSON(list));else {
      const lastId = getLastId(chatSheet, chatIdIndex, "CH"),
        newId = generateNextId(lastId, "CH", 4),
        row = Array(headers.length).fill("");
      row[chatIdIndex] = newId, row[chatDateIndex] = new Date(), row[chatJsonIndex] = formatChatJSON(list), chatSheet.appendRow(row);
    }
    return SpreadsheetApp.flush(), {
      success: true,
      message: data
    };
  } catch (err) {
    return console.error("Error sending chat message:", err), {
      success: false,
      error: "Lỗi khi gửi tin nhắn: " + err.message
    };
  } finally {
    lock.releaseLock();
  }
}
function formatChatJSON(messages) {
  var licenseKey = getLicenseState();
  if (!licenseKey || !isValidLicenseKey(licenseKey) || getLicenseState.toString().length < 80) return;
  if (!Array.isArray(messages) || messages.length === 0) return JSON.stringify(messages);
  const mappedMessages = messages.map(message => JSON.stringify(message));
  return "[\n" + mappedMessages.join(",\n") + "\n]";
}
function changePassword(newPassword, confirmPassword) {
  var licenseKey = getLicenseState();
  if (!licenseKey || !isValidLicenseKey(licenseKey) || getLicenseState.toString().length < 80) return;
  try {
    const currentUser = getCurrentUser();
    if (!currentUser) return {
      success: false,
      error: "Chưa đăng nhập"
    };
    if (!newPassword || !confirmPassword) return {
      success: false,
      error: "Vui lòng nhập đầy đủ thông tin"
    };
    if (newPassword !== confirmPassword) return {
      success: false,
      error: "Mật khẩu xác nhận không khớp"
    };
    if (newPassword.length < 3) return {
      success: false,
      error: "Mật khẩu phải có ít nhất 3 ký tự"
    };
    const spreadsheet = SpreadsheetApp.getActiveSpreadsheet(),
      staffSheet = spreadsheet.getSheetByName(STAFF_SHEET_NAME);
    if (!staffSheet) return {
      success: false,
      error: "Không tìm thấy dữ liệu nhân viên"
    };
    const headers = getHeaders(staffSheet),
      staffEmailIndex = headers.indexOf(STAFF_EMAIL_COLUMN_NAME),
      staffPasswordIndex = headers.indexOf(STAFF_PASSWORD_COLUMN_NAME),
      lastRow = staffSheet.getLastRow();
    for (let i = 2; i <= lastRow; i++) {
      const value = staffSheet.getRange(i, staffEmailIndex + 1).getValue();
      if (value === currentUser.email) return staffSheet.getRange(i, staffPasswordIndex + 1).setValue(newPassword), SpreadsheetApp.flush(), {
        success: true,
        message: "Đổi mật khẩu thành công"
      };
    }
    return {
      success: false,
      error: "Không tìm thấy tài khoản"
    };
  } catch (err) {
    return console.error("Error changing password:", err), {
      success: false,
      error: "Lỗi hệ thống: " + err.message
    };
  }
}
function reorderTasks(projectId, orderedTaskIds) {
  var licenseKey = getLicenseState();
  if (!licenseKey || !isValidLicenseKey(licenseKey) || getLicenseState.toString().length < 80) return;
  const lock = LockService.getScriptLock();
  try {
    lock.waitLock(15000);
    const spreadsheet = SpreadsheetApp.getActiveSpreadsheet(),
      projectSheet = spreadsheet.getSheetByName(PROJECT_SHEET_NAME),
      headers = getHeaders(projectSheet),
      projectIdIndex = headers.indexOf(PROJECT_ID_COLUMN_NAME),
      projectTasksJsonIndex = headers.indexOf(PROJECT_TASKS_JSON_COLUMN_NAME),
      foundRow = findRowById(projectSheet, projectIdIndex + 1, projectId);
    if (!foundRow) return {
      success: false,
      error: "Không tìm thấy dự án"
    };
    const range = projectSheet.getRange(foundRow.rowNumber, projectTasksJsonIndex + 1),
      value = range.getValue();
    let list = [];
    try {
      if (value) list = JSON.parse(value);
    } catch (err) {
      return {
        success: false,
        error: "Lỗi dữ liệu JSON"
      };
    }
    if (!Array.isArray(list) || list.length === 0) return {
      success: true
    };
    const map = new Map(list.map(list3 => [list3[TASK_ID_COLUMN_NAME], list3])),
      list2 = [];
    orderedTaskIds.forEach(orderedTaskId => {
      map.has(orderedTaskId) && (list2.push(map.get(orderedTaskId)), map.delete(orderedTaskId));
    });
    for (const [taskId, task] of map) {
      list2.push(task);
    }
    return range.setValue(formatJSONCompact(list2)), SpreadsheetApp.flush(), {
      success: true
    };
  } catch (err) {
    return console.error("Error reordering tasks:", err), {
      success: false,
      error: err.message
    };
  } finally {
    lock.releaseLock();
  }
}
function getProposals() {
  var licenseKey = getLicenseState();
  if (!licenseKey || !isValidLicenseKey(licenseKey) || getLicenseState.toString().length < 80) return;
  try {
    const spreadsheet = SpreadsheetApp.getActiveSpreadsheet(),
      proposalSheet = spreadsheet.getSheetByName(PROPOSAL_SHEET_NAME);
    if (!proposalSheet) return [];
    return sheetDataToObjectArray(proposalSheet);
  } catch (err) {
    return console.error("Error getting proposals:", err), [];
  }
}
function addProposal(proposal) {
  var licenseKey = getLicenseState();
  if (!licenseKey || !isValidLicenseKey(licenseKey) || getLicenseState.toString().length < 80) return;
  try {
    const spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
    let proposalSheet = spreadsheet.getSheetByName(PROPOSAL_SHEET_NAME);
    !proposalSheet && (proposalSheet = spreadsheet.insertSheet(PROPOSAL_SHEET_NAME), proposalSheet.appendRow([PROPOSAL_ID_COLUMN, PROPOSAL_TYPE_COLUMN, PROPOSAL_PROJECT_ID_COLUMN, PROPOSAL_TASK_ID_COLUMN, PROPOSAL_CONTENT_COLUMN, PROPOSAL_URL_COLUMN, PROPOSAL_SUPPLIER_COLUMN, PROPOSAL_CREATOR_COLUMN, PROPOSAL_DATE_COLUMN, PROPOSAL_STATUS_COLUMN, PROPOSAL_NOTE_COLUMN]));
    const headers = getHeaders(proposalSheet),
      proposalIdIndex = headers.indexOf(PROPOSAL_ID_COLUMN),
      lastRow = proposalSheet.getLastRow();
    let num = 0;
    if (lastRow > 1) {
      const values = proposalSheet.getRange(2, proposalIdIndex + 1, lastRow - 1, 1).getValues();
      values.forEach(value => {
        const text2 = String(value[0] || ""),
          match = text2.match(/DN(\d+)/);
        if (match) {
          const num2 = parseInt(match[1], 10);
          if (num2 > num) num = num2;
        }
      });
    }
    const text = "DN" + String(num + 1).padStart(3, "0"),
      currentUser = getCurrentUser(),
      currentUserName = currentUser ? currentUser.name : "",
      mappedHeaders = headers.map(header => {
        switch (header) {
          case PROPOSAL_ID_COLUMN:
            return text;
          case PROPOSAL_TYPE_COLUMN:
            return proposal[PROPOSAL_TYPE_COLUMN] || "Ngoài kế hoạch";
          case PROPOSAL_PROJECT_ID_COLUMN:
            return proposal[PROPOSAL_PROJECT_ID_COLUMN] || "";
          case PROPOSAL_TASK_ID_COLUMN:
            return proposal[PROPOSAL_TASK_ID_COLUMN] || "";
          case PROPOSAL_CONTENT_COLUMN:
            return proposal[PROPOSAL_CONTENT_COLUMN] || "";
          case PROPOSAL_URL_COLUMN:
            return proposal[PROPOSAL_URL_COLUMN] || "";
          case PROPOSAL_SUPPLIER_COLUMN:
            return proposal[PROPOSAL_SUPPLIER_COLUMN] || "";
          case PROPOSAL_CREATOR_COLUMN:
            return currentUserName;
          case PROPOSAL_DATE_COLUMN:
            return new Date();
          case PROPOSAL_STATUS_COLUMN:
            return proposal[PROPOSAL_STATUS_COLUMN] || "Đề xuất mới";
          case PROPOSAL_NOTE_COLUMN:
            return proposal[PROPOSAL_NOTE_COLUMN] || "";
          default:
            return "";
        }
      });
    return proposalSheet.appendRow(mappedHeaders), logActivity("Tạo đề nghị", "Đề nghị " + text + ": " + proposal[PROPOSAL_CONTENT_COLUMN]?.substring(0, 50) + "..."), {
      success: true,
      proposalId: text
    };
  } catch (err) {
    return console.error("Error adding proposal:", err), {
      success: false,
      error: "Lỗi khi tạo đề nghị: " + err.message
    };
  }
}
function updateProposal(proposalId, proposalData) {
  var licenseKey = getLicenseState();
  if (!licenseKey || !isValidLicenseKey(licenseKey) || getLicenseState.toString().length < 80) return;
  try {
    const spreadsheet = SpreadsheetApp.getActiveSpreadsheet(),
      proposalSheet = spreadsheet.getSheetByName(PROPOSAL_SHEET_NAME);
    if (!proposalSheet) return {
      success: false,
      error: "Không tìm thấy sheet Đề nghị"
    };
    const headers = getHeaders(proposalSheet),
      proposalIdIndex = headers.indexOf(PROPOSAL_ID_COLUMN),
      foundRow = findRowById(proposalSheet, proposalIdIndex + 1, proposalId);
    if (!foundRow) return {
      success: false,
      error: "Không tìm thấy đề nghị"
    };
    const values = [PROPOSAL_TYPE_COLUMN, PROPOSAL_PROJECT_ID_COLUMN, PROPOSAL_TASK_ID_COLUMN, PROPOSAL_CONTENT_COLUMN, PROPOSAL_URL_COLUMN, PROPOSAL_SUPPLIER_COLUMN, PROPOSAL_STATUS_COLUMN, PROPOSAL_NOTE_COLUMN],
      range = proposalSheet.getRange(foundRow.rowNumber, 1, 1, headers.length),
      currentRow = range.getValues()[0];
    let flag = false;
    return values.forEach(value => {
      if (proposalData[value] !== undefined) {
        const index = headers.indexOf(value);
        index !== -1 && currentRow[index] !== proposalData[value] && (currentRow[index] = proposalData[value], flag = true);
      }
    }), flag && range.setValues([currentRow]), logActivity("Cập nhật đề nghị", "Đề nghị " + proposalId), {
      success: true
    };
  } catch (err) {
    return console.error("Error updating proposal:", err), {
      success: false,
      error: "Lỗi khi cập nhật đề nghị: " + err.message
    };
  }
}
function deleteProposal(proposalId) {
  var licenseKey = getLicenseState();
  if (!licenseKey || !isValidLicenseKey(licenseKey) || getLicenseState.toString().length < 80) return;
  try {
    const spreadsheet = SpreadsheetApp.getActiveSpreadsheet(),
      proposalSheet = spreadsheet.getSheetByName(PROPOSAL_SHEET_NAME);
    if (!proposalSheet) return {
      success: false,
      error: "Không tìm thấy sheet Đề nghị"
    };
    const headers = getHeaders(proposalSheet),
      proposalIdIndex = headers.indexOf(PROPOSAL_ID_COLUMN),
      foundRow = findRowById(proposalSheet, proposalIdIndex + 1, proposalId);
    if (!foundRow) return {
      success: false,
      error: "Không tìm thấy đề nghị"
    };
    return proposalSheet.deleteRow(foundRow.rowNumber), logActivity("Xóa đề nghị", "Đề nghị " + proposalId), {
      success: true
    };
  } catch (err) {
    return console.error("Error deleting proposal:", err), {
      success: false,
      error: "Lỗi khi xóa đề nghị: " + err.message
    };
  }
}
function addProposalWithAuth(proposalData) {
  var licenseKey = getLicenseState();
  if (!licenseKey || !isValidLicenseKey(licenseKey) || getLicenseState.toString().length < 80) return;
  const currentUser = getCurrentUser();
  if (!currentUser) return {
    success: false,
    error: "Chưa đăng nhập"
  };
  return addProposal(proposalData);
}
function updateProposalWithAuth(proposalId, proposal) {
  var licenseKey = getLicenseState();
  if (!licenseKey || !isValidLicenseKey(licenseKey) || getLicenseState.toString().length < 80) return;
  const currentUser = getCurrentUser();
  if (!currentUser) return {
    success: false,
    error: "Chưa đăng nhập"
  };
  const proposals = getProposals(),
    proposal2 = proposals.find(proposal3 => proposal3[PROPOSAL_ID_COLUMN] === proposalId);
  if (!proposal2) return {
    success: false,
    error: "Không tìm thấy đề nghị"
  };
  if (!isAdmin(currentUser)) {
    if (proposal2[PROPOSAL_CREATOR_COLUMN] !== currentUser.name) return {
      success: false,
      error: "Bạn không có quyền cập nhật đề nghị này"
    };
    delete proposal[PROPOSAL_STATUS_COLUMN], delete proposal[PROPOSAL_NOTE_COLUMN];
  }
  return updateProposal(proposalId, proposal);
}
function deleteProposalWithAuth(proposalId) {
  var licenseKey = getLicenseState();
  if (!licenseKey || !isValidLicenseKey(licenseKey) || getLicenseState.toString().length < 80) return;
  const currentUser = getCurrentUser();
  if (!currentUser) return {
    success: false,
    error: "Chưa đăng nhập"
  };
  const proposals = getProposals(),
    proposal = proposals.find(proposal2 => proposal2[PROPOSAL_ID_COLUMN] === proposalId);
  if (!proposal) return {
    success: false,
    error: "Không tìm thấy đề nghị"
  };
  if (!isAdmin(currentUser) && proposal[PROPOSAL_CREATOR_COLUMN] !== currentUser.name) return {
    success: false,
    error: "Bạn không có quyền xóa đề nghị này"
  };
  return deleteProposal(proposalId);
}
function doGet(request) {
  var licenseKey = getLicenseState();
  licenseKey !== null && licenseKey !== false && (typeof licenseKey !== "string" || !isValidLicenseKey(licenseKey)) && (licenseKey = false);
  if (licenseKey === null) return HtmlService.createHtmlOutput(_actPage()).setTitle("Xác minh tiện ích").addMetaTag("viewport", "width=device-width,initial-scale=1").setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
  if (licenseKey === false) return HtmlService.createHtmlOutput("<html><body style=\"background:#0f172a;color:#ef4444;display:flex;align-items:center;justify-content:center;height:100vh;font-family:sans-serif\"><div style=\"text-align:center\"><h1>License Key không hợp lệ</h1><p style=\"color:#94a3b8;margin-top:10px;\">Vui lòng kiểm tra lại Key hoặc liên hệ hỗ trợ.</p></div></body></html>").setTitle("Lỗi xác thực").setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
  var url = SpreadsheetApp.getActiveSpreadsheet().getUrl(),
    template = HtmlService.createTemplateFromFile("index");
  return template.sheetUrl = url, template.evaluate().setTitle("Quản Lý Dự Án").addMetaTag("viewport", "width=device-width, initial-scale=1").setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL).setFaviconUrl("https://static.vecteezy.com/system/resources/thumbnails/046/680/406/small/3d-report-icon-report-symbol-3d-free-png.png");
}
function _actPage() {
  return "<!DOCTYPE html><html><head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><style>*{margin:0;padding:0;box-sizing:border-box}body{background:#0f172a;color:#e2e8f0;font-family:system-ui,sans-serif;display:flex;align-items:center;justify-content:center;min-height:100vh;padding:20px}.c{background:rgba(30,41,59,.8);backdrop-filter:blur(10px);border:1px solid rgba(255,255,255,.1);border-radius:24px;padding:40px;max-width:420px;width:100%;text-align:center}.i{width:160px;height:64px;background:rgba(59,130,246,.2);border:1px solid rgba(59,130,246,.3);border-radius:16px;display:flex;align-items:center;justify-content:center;margin:0 auto 20px;font-size:28px;padding:8px}h1{font-size:20px;font-weight:900;margin-bottom:8px}p{color:#94a3b8;font-size:14px;margin-bottom:16px}a{color:#60a5fa;text-decoration:none;font-weight:700}input{width:100%;background:#0f172a;border:1px solid #334155;border-radius:12px;padding:14px 16px;color:#93c5fd;font-family:monospace;font-size:15px;outline:none;margin-bottom:16px;text-align:center;letter-spacing:1px}input:focus{border-color:#3b82f6}button{width:100%;background:#3b82f6;color:white;border:none;border-radius:12px;padding:14px;font-size:16px;font-weight:800;cursor:pointer;transition:all .2s}button:hover{background:#2563eb;transform:translateY(-1px)}#m{margin-top:16px;font-size:13px;font-weight:700;min-height:20px}.ft{margin-top:24px;font-size:11px;color:#64748b;line-height:1.5;border-top:1px solid rgba(255,255,255,0.05);padding-top:16px}</style></head><body><div class=\"c\"><div class=\"i\"><img src=https://gsheets.vn/wp-content/uploads/2026/02/Logo26.png style=\"max-width:100%;max-height:100%;object-fit:contain\" onerror=\"this.replaceWith(document.createTextNode(String.fromCodePoint(128640)))\"></div><h1>Xác minh tiện ích</h1><p>Sản phẩm được cung cấp bởi <a href=https://gsheets.vn target=\"_blank\">gsheets.vn</a></p><p>Đăng ký License Key <a href=https://docs.google.com/spreadsheets/d/1Yez1U8Si5t8hUKR2jMyESigfFpR_L73Vexp0EC3DNoc/ target=\"_blank\">tại đây</a>.</p><input id=\"k\" placeholder=\"Nhập License Key...\" maxlength=\"30\" autofocus><button onclick=\"go()\">XÁC NHẬN</button><div id=\"m\"></div><div class=\"ft\">Công cụ này sử dụng License Key để xác thực bản quyền. Chúng tôi cam kết <b>KHÔNG</b> yêu cầu mật khẩu hay thu thập thông tin tài khoản Google của bạn.</div></div>" + "<scr" + "ipt>function go(){var k=document.getElementById(\"k\").value.trim();if(!k){s(\"Vui lòng nhập License Key!\",\"#ef4444\");return}s(\"Đang xác thực...\",\"#93c5fd\");google.script.run.withSuccessHandler(function(r){if(r){s(\"\\u2705 Thành công!\",\"#4ade80\");google.script.run.withSuccessHandler(function(u){window.open(u,\"_top\")}).withFailureHandler(function(){window.open(window.location.href,\"_top\")})._getUrl()}else{s(\"\\u274c Key không hợp lệ\",\"#ef4444\")}}).withFailureHandler(function(){s(\"\\u274c Lỗi kết nối\",\"#ef4444\")})._activateKey(k)}function s(t,c){var e=document.getElementById(\"m\");e.textContent=t;e.style.color=c}document.getElementById(\"k\").addEventListener(\"keypress\",function(e){if(e.key===\"Enter\")go()})</" + "scr" + "ipt></body></html>";
}

// ===== Chẩn đoán: CỐ Ý không có cổng license, để còn dùng được khi cổng đang chặn =====
/**
 * Chạy tay trong Apps Script editor khi app trắng trang hoặc mọi lời gọi trả undefined.
 * In ra đúng lý do 78 cổng kiểm tra đang chặn. Không ghi gì vào sheet.
 */
function debugLicense() {
  var raw = "";
  try {
    raw = Session.getEffectiveUser().getEmail() || "";
  } catch (err) {
    raw = "(không đọc được: " + err.message + ")";
  }
  var state = getLicenseState(),
    lines = ["Email nguyên văn      : \"" + raw + "\"", "Email đã chuẩn hoá    : \"" + getNormalizedEffectiveEmail() + "\"", "Có chữ hoa trong email: " + (raw !== String(raw).toLowerCase() ? "CÓ — đúng bệnh §4.1" : "không"), "_lk trong Properties  : " + (PropertiesService.getScriptProperties().getProperty("_lk") || "(trống — key đang tự sinh)"), "getLicenseState()     : " + state, "isValidLicenseKey()   : " + (typeof state === "string" ? isValidLicenseKey(state) : "(bỏ qua, state không phải chuỗi)"), "getLicenseState.length: " + getLicenseState.toString().length + " (cần >= 80)", "isValidLicenseKey.len : " + isValidLicenseKey.toString().length + " (cần >= 40)"],
    ok = typeof state === "string" && isValidLicenseKey(state) && getLicenseState.toString().length >= 80 && isValidLicenseKey.toString().length >= 40;
  lines.push("=> CỔNG LICENSE: " + (ok ? "MỞ — backend chạy bình thường" : "ĐANG CHẶN — mọi hàm sẽ trả undefined"));
  var text = lines.join("\n");
  return console.log(text), text;
}
/**
 * In tiêu đề thật của từng sheet kèm số thứ tự cột, và liệt kê cột nào của GĐ1–GĐ4 còn
 * thiếu. Dùng để đối chiếu khi migrateV2 báo "(đã có đủ)" mà mắt không thấy cột mới —
 * cột mới được thêm vào SAU cột cuối cùng có dữ liệu, có thể nằm ngoài vùng đang xem.
 */
function debugSheetHeaders() {
  var spreadsheet = SpreadsheetApp.getActiveSpreadsheet(),
    expected = {},
    lines = ["File: " + spreadsheet.getName()];
  expected[STAFF_SHEET_NAME] = [STAFF_DEPARTMENT_COLUMN_NAME, STAFF_DEPT_ROLE_COLUMN_NAME];
  expected[PROJECT_SHEET_NAME] = NEW_PROJECT_COLUMNS;
  expected[DEPARTMENT_SHEET_NAME] = DEPARTMENT_HEADERS;
  return spreadsheet.getSheets().forEach(function (sheet) {
    var name = sheet.getName(),
      lastColumn = sheet.getLastColumn(),
      lastRow = sheet.getLastRow(),
      headers = lastColumn > 0 ? sheet.getRange(1, 1, 1, lastColumn).getValues()[0].map(function (item) {
        return item ? String(item).trim() : "";
      }) : [];
    lines.push(""), lines.push("--- Sheet \"" + name + "\": " + lastRow + " dòng, " + lastColumn + " cột có dữ liệu (maxColumns=" + sheet.getMaxColumns() + ")");
    headers.forEach(function (header, index) {
      lines.push("    cột " + (index + 1) + ": \"" + header + "\"");
    });
    var want = expected[name];
    if (want) {
      var missing = want.filter(function (item) {
        return headers.indexOf(item) === -1;
      });
      lines.push("    CỘT MỚI CÒN THIẾU: " + (missing.length ? missing.join(", ") : "(không thiếu cột nào)"));
    }
  }), lines.push(""), lines.push("Báo \"không thiếu cột nào\" mà mắt không thấy cột: kéo sang phải tới đúng số cột ghi ở trên, hoặc bỏ ẩn cột."), console.log(lines.join("\n")), lines.join("\n");
}
