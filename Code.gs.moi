var _cr = "Bản quyền thuộc về gsheets.vn",
  _reed = [46, 58, 58, 39, 63, 44, 63, 26, 63, 16, 45, 30, 115, 28, 47, 32, 45, 48, 9, 44, 63, 124, 44, 56],
  _qjii = [8, 7913, 36, 106, 59, 63, 51, 7819, 36, 106, 62, 34, 63, 7827, 41, 106, 60, 7819, 106, 45, 57, 34, 47, 47, 62, 57, 100, 60, 36],
  _iwruum = "7vv119ir",
  _cachedEmail = null,
  _licenseCache;
const xorDecode = function (codes) {
    return codes.map(function (code) {
      return String.fromCharCode(code ^ 74);
    }).join("");
  },
  cyrb53Hash = function (input) {
    var num = 3735928559,
      num2 = 1103547991;
    for (var i = 0; i < input.length; i++) {
      var charCode = input.charCodeAt(i);
      num = Math.imul(num ^ charCode, 2654435761), num2 = Math.imul(num2 ^ charCode, 1597334677);
    }
    return num = Math.imul(num ^ num >>> 16, 2246822507) ^ Math.imul(num2 ^ num2 >>> 13, 3266489909), num2 = Math.imul(num2 ^ num2 >>> 16, 2246822507) ^ Math.imul(num ^ num >>> 13, 3266489909), (4294967296 * (2097151 & num2) + (num >>> 0)).toString(36);
  },
  isValidLicenseKey = function (key) {
    var decoded = xorDecode(_reed);
    if (_cachedEmail === null) _cachedEmail = Session.getEffectiveUser().getEmail().toLowerCase();
    return key === cyrb53Hash(_cachedEmail + decoded);
  },
  getLicenseState = function () {
    // --- BẮT ĐẦU CHỈNH SỬA TỪ ĐÂY ---

    // 1. Kiểm tra phiên bản (bỏ chặn)
    if (isValidLicenseKey.toString().length < 40) return _licenseCache = false;
    if (typeof _iwruum === "undefined" || _iwruum !== "7vv119ir") {
      // Nếu version không khớp, tự động set thành đúng để bypass
      _iwruum = "7vv119ir";
    }
    var decoded = xorDecode(_qjii);
    if (_cr !== decoded) return _licenseCache = false;

    // 2. Lấy key từ Properties hoặc tự động tạo cho user hiện tại
    var scriptProperties = PropertiesService.getScriptProperties(),
      storedLk = scriptProperties.getProperty("_lk");

    // Nếu chưa có key trong property, tự động tạo cho user hiện tại để không cần nhập Key thủ công
    if (!storedLk) {
      var email = Session.getEffectiveUser().getEmail();
      var decoded2 = xorDecode(_reed);
      // Tạo hash tương ứng với email hiện tại
      storedLk = cyrb53Hash(email + decoded2);
    }
