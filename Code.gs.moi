    if (projectTasksJsonIndex === -1) return [];
    const lastRow = projectSheet.getLastRow();
    if (lastRow < 2) return [];
    // Một lần đọc cho CẢ hai cột. Bản cũ gọi thêm getRange().getValue() một lần MỖI dòng chỉ
