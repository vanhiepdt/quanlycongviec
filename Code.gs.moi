  NEW_PROJECT_COLUMNS = [PROJECT_DEPARTMENT_COLUMN_NAME, PROJECT_MANAGER_EMAIL_COLUMN_NAME, PROJECT_APPROVAL_COLUMN_NAME, PROJECT_APPROVER_COLUMN_NAME, PROJECT_APPROVED_DATE_COLUMN_NAME, PROJECT_REJECT_REASON_COLUMN_NAME],
  NEW_TASK_COLUMNS = [TASK_LEVEL_COLUMN_NAME, TASK_PARENT_ID_COLUMN_NAME, TASK_ASSIGNEE_EMAIL_COLUMN_NAME, TASK_APPROVAL_COLUMN_NAME, TASK_APPROVER_COLUMN_NAME, TASK_APPROVED_DATE_COLUMN_NAME];


function include(filename) {
  return HtmlService.createHtmlOutputFromFile(filename).getContent();
}
function getInitialDataFast() {
  var licenseKey = getLicenseState();
  if (!licenseKey || !isValidLicenseKey(licenseKey) || getLicenseState.toString().length < 80) return;
  try {
    const spreadsheet = SpreadsheetApp.getActiveSpreadsheet(),
      id = spreadsheet.getId(),
      values = ["'" + PROJECT_SHEET_NAME + "'!A:Z", "'" + STAFF_SHEET_NAME + "'!A:H", "'" + PROPOSAL_SHEET_NAME + "'!A:K", "'" + APP_SHEET_NAME + "'!A:H"];
    let batchResponse;
    try {
      batchResponse = Sheets.Spreadsheets.Values.batchGet(id, {
        ranges: values,
        majorDimension: "ROWS"
      });
    } catch (err) {
      return console.warn("Batch get failed (possibly missing sheets), falling back to normal load:", err), getInitialData();
    }
    const values2 = batchResponse.valueRanges[0].values || [],
      rows = parseSheetData(values2),
      tasks = extractTasksFromProjectValues(values2),
      values3 = batchResponse.valueRanges[1].values || [],
      rows2 = parseSheetData(values3),
      values4 = batchResponse.valueRanges.length > 2 ? batchResponse.valueRanges[2].values || [] : [],
      rows3 = parseSheetData(values4),
      values5 = batchResponse.valueRanges.length > 3 ? batchResponse.valueRanges[3].values || [] : [],
      rows4 = parseSheetData(values5),
      taskStatusChartData = getTaskStatusChartData(tasks),
      summaryStats = getSummaryStats(rows, tasks),
      recentActivities = getRecentActivities();
    return {
      projects: rows,
      tasks: tasks,
      staff: rows2,
      proposals: rows3,
      apps: rows4,
      chartData: taskStatusChartData,
      recentActivities: recentActivities,
      summaryStats: summaryStats
    };
  } catch (err) {
    return console.error("Error in getInitialDataFast:", err), getInitialData();
  }
}
function extractTasksFromProjectValues(values) {
  var licenseKey = getLicenseState();
  if (!licenseKey || !isValidLicenseKey(licenseKey) || getLicenseState.toString().length < 80) return;
  if (!values || values.length < 2) return [];
  const headers = values[0],
    projectTasksJsonIndex = headers.indexOf(PROJECT_TASKS_JSON_COLUMN_NAME),
    projectIdIndex = headers.indexOf(PROJECT_ID_COLUMN_NAME);
  if (projectTasksJsonIndex === -1 || projectIdIndex === -1) return [];
  let list = [];
  for (let i = 1; i < values.length; i++) {
    const row = values[i];
    if (!row) continue;
    const projectId = row[projectIdIndex],
      // parseTaskJson: một ô JSON hỏng trả [] chứ không throw — bản cũ dùng JSON.parse trong
      // try/catch riêng, nay dồn về một chỗ để cả 2 đường đọc (fast + getTasks) xử lý giống nhau.
      parsed = parseTaskJson(row[projectTasksJsonIndex]);
    if (parsed.length === 0) continue;
    // GĐ2: bơm "Cấp" = 3 và "Mã cha" = "" cho dữ liệu chưa chạy migrateV2, ép "Cấp" về Number.
    list = list.concat(parsed.filter(item => item && typeof item === "object").map(item => normalizeTaskForOutput(item, projectId)));
  }
  return list;
}
function parseSheetData(values) {
  var licenseKey = getLicenseState();
  if (!licenseKey || !isValidLicenseKey(licenseKey) || getLicenseState.toString().length < 80) return;
  if (!values || values.length < 2) return [];
  const headers = values[0],
    slice = values.slice(1);
  return slice.map(slice2 => {
    const data = {};
    return headers.forEach((header, index) => {
      if (header && index < slice2.length) {
        let slice22 = slice2[index];
        typeof slice22 === "string" && slice22.match(/^\d{4}-\d{2}-\d{2}$/) && (slice22 = new Date(slice22 + "T00:00:00")), data[header] = slice22 !== undefined ? slice22 : "";
      }
    }), data;
  });
}
function authenticateUser(email, password) {
  var licenseKey = getLicenseState();
  if (!licenseKey || !isValidLicenseKey(licenseKey) || getLicenseState.toString().length < 80) return;
  try {
    if (!email || !password) return {
      success: false,
      error: "Email và mật khẩu là bắt buộc"
    };
    const spreadsheet = SpreadsheetApp.getActiveSpreadsheet(),
      staffSheet = spreadsheet.getSheetByName(STAFF_SHEET_NAME);
    if (!staffSheet) return {
      success: false,
      error: "Không tìm thấy dữ liệu nhân viên"
    };
    const headers = getHeaders(staffSheet),
      staffEmailIndex = headers.indexOf(STAFF_EMAIL_COLUMN_NAME),
      staffPasswordIndex = headers.indexOf(STAFF_PASSWORD_COLUMN_NAME),
      staffRoleIndex = headers.indexOf(STAFF_ROLE_COLUMN_NAME),
      staffIndex = headers.indexOf(STAFF_NAME_COLUMN_NAME),
      staffIdIndex = headers.indexOf(STAFF_ID_COLUMN_NAME);
    if (staffEmailIndex === -1 || staffPasswordIndex === -1 || staffRoleIndex === -1) return {
      success: false,
      error: "Cấu trúc dữ liệu nhân viên không đúng"
    };
    const lastRow = staffSheet.getLastRow();
    if (lastRow < 2) return {
      success: false,
      error: "Không có dữ liệu nhân viên"
    };
    const range = staffSheet.getRange(2, 1, lastRow - 1, headers.length),
      values = range.getValues();
    for (let i = 0; i < values.length; i++) {
      const value = values[i],
        lower = String(value[staffEmailIndex] || "").trim().toLowerCase(),
        trimmed = String(value[staffPasswordIndex] || "").trim();
      if (lower === email.toLowerCase() && trimmed === password) {
        const data = {
          id: value[staffIdIndex] || "",
          name: value[staffIndex] || "",
          email: value[staffEmailIndex] || "",
          role: value[staffRoleIndex] || "Nhân viên",
          position: value[headers.indexOf(STAFF_POSITION_COLUMN_NAME)] || "",
          department: headers.indexOf(STAFF_DEPARTMENT_COLUMN_NAME) === -1 ? "" : String(value[headers.indexOf(STAFF_DEPARTMENT_COLUMN_NAME)] || "").trim(),
          deptRole: headers.indexOf(STAFF_DEPT_ROLE_COLUMN_NAME) === -1 ? "" : String(value[headers.indexOf(STAFF_DEPT_ROLE_COLUMN_NAME)] || "").trim()
        };
        return storeUserSession(data), {
          success: true,
          user: data,
          message: "Đăng nhập thành công"
        };
      }
    }
    return {
      success: false,
      error: "Email hoặc mật khẩu không đúng"
    };
  } catch (err) {
    return console.error("Authentication error:", err), {
      success: false,
      error: "Lỗi hệ thống khi đăng nhập: " + err.message
    };
  }
}
function storeUserSession(user) {
  var licenseKey = getLicenseState();
  if (!licenseKey || !isValidLicenseKey(licenseKey) || getLicenseState.toString().length < 80) return;
  try {
    const temporaryActiveUserKey = Session.getTemporaryActiveUserKey(),
      data = {
        ...user,
        loginTime: new Date().toISOString(),
        sessionId: Utilities.getUuid()
      },
      text = "user_session_" + user.email + "_" + temporaryActiveUserKey;
    PropertiesService.getScriptProperties().setProperty(text, JSON.stringify(data));
  } catch (err) {
    console.error("Error storing session:", err);
  }
}
function getCurrentUser() {
  var licenseKey = getLicenseState();
  if (!licenseKey || !isValidLicenseKey(licenseKey) || getLicenseState.toString().length < 80) return;
  try {
    const temporaryActiveUserKey = Session.getTemporaryActiveUserKey(),
      properties = PropertiesService.getScriptProperties().getProperties();
    for (const propertyKey in properties) {
      if (propertyKey.endsWith("_" + temporaryActiveUserKey) && propertyKey.startsWith("user_session_")) try {
        const parsed = JSON.parse(properties[propertyKey]),
          loginTime = new Date(parsed.loginTime),
          now = new Date(),
          num = 86400000;
        if (now - loginTime > num) return PropertiesService.getScriptProperties().deleteProperty(propertyKey), null;
        return parsed;
      } catch (err) {
        continue;
      }
    }
    return null;
  } catch (err) {
    return console.error("Error getting current user:", err), null;
  }
}
function logout() {
  var licenseKey = getLicenseState();
  if (!licenseKey || !isValidLicenseKey(licenseKey) || getLicenseState.toString().length < 80) return;
  try {
    const temporaryActiveUserKey = Session.getTemporaryActiveUserKey(),
      properties = PropertiesService.getScriptProperties().getProperties();
    for (const propertyKey in properties) {
      if (propertyKey.endsWith("_" + temporaryActiveUserKey) && propertyKey.startsWith("user_session_")) {
        PropertiesService.getScriptProperties().deleteProperty(propertyKey);
        break;
      }
    }
    return {
      success: true,
      message: "Đăng xuất thành công"
    };
  } catch (err) {
    return console.error("Error during logout:", err), {
      success: false,
      error: "Lỗi khi đăng xuất"
    };
  }
}
function isAdmin(user) {
  var licenseKey = getLicenseState();
  if (!licenseKey || !isValidLicenseKey(licenseKey) || getLicenseState.toString().length < 80) return;
  if (!user) return false;
  return String(user.role || "").toLowerCase().includes("admin");
}
function isManager(user) {
  var licenseKey = getLicenseState();
  if (!licenseKey || !isValidLicenseKey(licenseKey) || getLicenseState.toString().length < 80) return;
  if (!user) return false;
  return String(user.role || "").toLowerCase().includes("quản lý");
}

// ===== GĐ1: helper phòng ban =====
/** Chuẩn hoá email để so sánh: cắt trắng + hạ chữ thường. Trả "" nếu không có. */
function normalizeEmail(value) {
  return String(value || "").trim().toLowerCase();
}
/** Tách chuỗi nhiều email cách nhau bởi ; , hoặc khoảng trắng thành mảng đã chuẩn hoá. */
function parseEmailList(value) {
  return String(value || "").split(/[;,\s]+/).map(normalizeEmail).filter(item => item !== "");
}
/** Ghi giá trị vào ô nếu cột đó có trong sheet. Cho phép code mới chạy trên sheet chưa migrate. */
function setCellIfColumnExists(row, headers, columnName, value) {
  const index = headers.indexOf(columnName);
  return index !== -1 && (row[index] = value), row;
}
/** Đọc sheet Phòng, tự tạo kèm 4 phòng mặc định nếu chưa có. Đã sắp theo cột Thứ tự. */
function getDepartments() {
  var licenseKey = getLicenseState();
  if (!licenseKey || !isValidLicenseKey(licenseKey) || getLicenseState.toString().length < 80) return;
  try {
    const spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
    let sheet = spreadsheet.getSheetByName(DEPARTMENT_SHEET_NAME);
    if (!sheet) {
      sheet = getOrCreateSheet(spreadsheet, DEPARTMENT_SHEET_NAME, DEPARTMENT_HEADERS);
      seedDefaultDepartments(sheet);
    }
    const rows = sheetDataToObjectArray(sheet) || [];
    return rows.sort((a, b) => (Number(a[DEPT_ORDER_COLUMN_NAME]) || 99) - (Number(b[DEPT_ORDER_COLUMN_NAME]) || 99));
  } catch (err) {
    return console.error("Error getting departments:", err), [];
  }
}
/** Ghi 4 phòng mặc định vào sheet Phòng còn rỗng. */
function seedDefaultDepartments(sheet) {
  if (!sheet || sheet.getLastRow() > 1) return;
  const headers = getHeaders(sheet),
    rows = DEFAULT_DEPARTMENTS.map((name, index) => {
      const row = Array(headers.length).fill("");
      return row[headers.indexOf(DEPT_ID_COLUMN_NAME)] = "PH" + ("00" + (index + 1)).slice(-2), row[headers.indexOf(DEPT_NAME_COLUMN_NAME)] = name, row[headers.indexOf(DEPT_ORDER_COLUMN_NAME)] = index + 1, row;
    });
  sheet.getRange(2, 1, rows.length, headers.length).setValues(rows), SpreadsheetApp.flush();
}
/** Chỉ tên 4 phòng, dùng cho ô chọn ở giao diện. */
function getDepartmentNames() {
  return (getDepartments() || []).map(item => String(item[DEPT_NAME_COLUMN_NAME] || "").trim()).filter(item => item !== "");
}
function isDeputyDirector(user) {
  var licenseKey = getLicenseState();
  if (!licenseKey || !isValidLicenseKey(licenseKey) || getLicenseState.toString().length < 80) return;
  if (!user) return false;
  return String(user.role || "").toLowerCase().includes("phó giám đốc");
}
/**
 * Phòng và vai trò trong phòng của một người.
 * Ưu tiên dữ liệu trong session; session cũ (đăng nhập trước GĐ1) chưa có thì tra sheet
 * Người dùng theo email. Trả { department, deptRole }.
 */
function getUserDeptInfo(user) {
  var licenseKey = getLicenseState();
  if (!licenseKey || !isValidLicenseKey(licenseKey) || getLicenseState.toString().length < 80) return;
  if (!user) return {
    department: "",
    deptRole: ""
  };
  if (user.department !== undefined || user.deptRole !== undefined) return {
    department: String(user.department || "").trim(),
    deptRole: String(user.deptRole || "").trim()
  };
  const email = normalizeEmail(user.email),
    staff = (getStaffList() || []).find(item => normalizeEmail(item[STAFF_EMAIL_COLUMN_NAME]) === email);
  return {
    department: staff ? String(staff[STAFF_DEPARTMENT_COLUMN_NAME] || "").trim() : "",
    deptRole: staff ? String(staff[STAFF_DEPT_ROLE_COLUMN_NAME] || "").trim() : ""
  };
}
/** Trưởng phòng hoặc Phó phòng — hai vai trò này có quyền như nhau (quyết định số 5). */
function isDepartmentHead(user) {
  var licenseKey = getLicenseState();
  if (!licenseKey || !isValidLicenseKey(licenseKey) || getLicenseState.toString().length < 80) return;
  if (!user) return false;
  const deptRole = getUserDeptInfo(user).deptRole.toLowerCase();
  if (deptRole.includes("trưởng phòng") || deptRole.includes("phó phòng")) return true;
  const email = normalizeEmail(user.email);
  return (getDepartments() || []).some(item => parseEmailList(item[DEPT_HEAD_COLUMN_NAME]).includes(email) || parseEmailList(item[DEPT_VICE_COLUMN_NAME]).includes(email));
}
/** Danh sách tên phòng mà một Phó Giám đốc phụ trách (đọc từ sheet Phòng). */
function getDepartmentsManagedBy(email) {
  var licenseKey = getLicenseState();
  if (!licenseKey || !isValidLicenseKey(licenseKey) || getLicenseState.toString().length < 80) return;
  const lower = normalizeEmail(email);
  if (!lower) return [];
  return (getDepartments() || []).filter(item => parseEmailList(item[DEPT_DIRECTOR_COLUMN_NAME]).includes(lower)).map(item => String(item[DEPT_NAME_COLUMN_NAME] || "").trim());
}
/**
 * Các phòng một người được xem. Admin: tất cả. Phó Giám đốc: phòng phụ trách.
 * Còn lại: đúng phòng của mình. Trả mảng tên phòng.
 */
function getVisibleDepartments(user) {
  var licenseKey = getLicenseState();
  if (!licenseKey || !isValidLicenseKey(licenseKey) || getLicenseState.toString().length < 80) return;
  if (!user) return [];
  if (isAdmin(user)) return getDepartmentNames();
  if (isDeputyDirector(user)) return getDepartmentsManagedBy(user.email);
  const department = getUserDeptInfo(user).department;
  return department ? [department] : [];
}
/** Người này có được thao tác trong phòng đó không. */
function canAccessDepartment(user, department) {
  var licenseKey = getLicenseState();
  if (!licenseKey || !isValidLicenseKey(licenseKey) || getLicenseState.toString().length < 80) return;
  if (!user) return false;
  if (isAdmin(user)) return true;
  const trimmed = String(department || "").trim();
  if (!trimmed) return false;
  return (getVisibleDepartments(user) || []).some(item => item === trimmed);
}
/** Dữ liệu phòng ban cho frontend dựng ô chọn và biết quyền của mình. */
function getDepartmentContext() {
  var licenseKey = getLicenseState();
  if (!licenseKey || !isValidLicenseKey(licenseKey) || getLicenseState.toString().length < 80) return;
  try {
    const currentUser = getCurrentUser();
    if (!currentUser) return {
      success: false,
      error: "Chưa đăng nhập"
    };
    const deptInfo = getUserDeptInfo(currentUser);
    return {
      success: true,
      departments: getDepartments() || [],
      departmentNames: getDepartmentNames() || [],
      visibleDepartments: getVisibleDepartments(currentUser) || [],
      myDepartment: deptInfo.department,
      myDeptRole: deptInfo.deptRole,
      isDeputyDirector: isDeputyDirector(currentUser) === true,
      isDepartmentHead: isDepartmentHead(currentUser) === true
    };
  } catch (err) {
    return console.error("Error getting department context:", err), {
      success: false,
      error: err.message
    };
  }
}
/** Thêm phòng. Chỉ admin (kiểm ở bản WithAuth). */
function addDepartment(departmentData) {
  var licenseKey = getLicenseState();
  if (!licenseKey || !isValidLicenseKey(licenseKey) || getLicenseState.toString().length < 80) return;
  const lock = LockService.getScriptLock();
  try {
    lock.waitLock(15000);
    const name = String(departmentData && departmentData.name || "").trim();
    if (!name) return {
      success: false,
      error: "Tên phòng là bắt buộc."
    };
    const spreadsheet = SpreadsheetApp.getActiveSpreadsheet(),
      sheet = getOrCreateSheet(spreadsheet, DEPARTMENT_SHEET_NAME, DEPARTMENT_HEADERS),
      headers = getHeaders(sheet),
      existing = sheetDataToObjectArray(sheet) || [];
    if (existing.some(item => String(item[DEPT_NAME_COLUMN_NAME] || "").trim().toLowerCase() === name.toLowerCase())) return {
      success: false,
      error: "Phòng \"" + name + "\" đã tồn tại."
    };
    const idIndex = headers.indexOf(DEPT_ID_COLUMN_NAME),
      newId = generateNextId(getLastId(sheet, idIndex, "PH"), "PH", 2),
      row = Array(headers.length).fill("");
    return row[idIndex] = newId, row[headers.indexOf(DEPT_NAME_COLUMN_NAME)] = name, row[headers.indexOf(DEPT_DIRECTOR_COLUMN_NAME)] = normalizeEmail(departmentData.director), row[headers.indexOf(DEPT_HEAD_COLUMN_NAME)] = normalizeEmail(departmentData.head), row[headers.indexOf(DEPT_VICE_COLUMN_NAME)] = String(departmentData.vice || "").trim().toLowerCase(), row[headers.indexOf(DEPT_ORDER_COLUMN_NAME)] = Number(departmentData.order) || existing.length + 1, row[headers.indexOf(DEPT_NOTES_COLUMN_NAME)] = String(departmentData.notes || "").trim(), sheet.appendRow(row), SpreadsheetApp.flush(), {
      success: true,
      departmentId: newId
    };
  } catch (err) {
    return console.error("Error adding department:", err), {
      success: false,
      error: "Lỗi khi thêm phòng: " + err.message
    };
  } finally {
    lock.releaseLock();
  }
}
/** Sửa phòng: đổi tên, đổi Phó GĐ phụ trách, đổi Trưởng/Phó phòng, đổi thứ tự. */
function updateDepartment(departmentId, departmentData) {
  var licenseKey = getLicenseState();
  if (!licenseKey || !isValidLicenseKey(licenseKey) || getLicenseState.toString().length < 80) return;
  const lock = LockService.getScriptLock();
  try {
    lock.waitLock(15000);
    if (!departmentId) return {
      success: false,
      error: "Chưa có mã phòng."
    };
    const spreadsheet = SpreadsheetApp.getActiveSpreadsheet(),
      sheet = spreadsheet.getSheetByName(DEPARTMENT_SHEET_NAME);
    if (!sheet) return {
      success: false,
      error: "Không tìm thấy sheet \"" + DEPARTMENT_SHEET_NAME + "\"."
    };
    const headers = getHeaders(sheet),
      idIndex = headers.indexOf(DEPT_ID_COLUMN_NAME),
      foundRow = findRowById(sheet, idIndex + 1, departmentId);
    if (!foundRow) return {
      success: false,
      error: "Không tìm thấy phòng: " + departmentId
    };
    const range = sheet.getRange(foundRow.rowNumber, 1, 1, headers.length),
      currentRow = range.getValues()[0],
      oldName = String(currentRow[headers.indexOf(DEPT_NAME_COLUMN_NAME)] || "").trim(),
      newName = departmentData.name === undefined ? oldName : String(departmentData.name).trim();
    if (!newName) return {
      success: false,
      error: "Tên phòng là bắt buộc."
    };
    const values = [[headers.indexOf(DEPT_NAME_COLUMN_NAME), newName], [headers.indexOf(DEPT_DIRECTOR_COLUMN_NAME), departmentData.director === undefined ? undefined : normalizeEmail(departmentData.director)], [headers.indexOf(DEPT_HEAD_COLUMN_NAME), departmentData.head === undefined ? undefined : normalizeEmail(departmentData.head)], [headers.indexOf(DEPT_VICE_COLUMN_NAME), departmentData.vice === undefined ? undefined : String(departmentData.vice).trim().toLowerCase()], [headers.indexOf(DEPT_ORDER_COLUMN_NAME), departmentData.order === undefined ? undefined : Number(departmentData.order) || ""], [headers.indexOf(DEPT_NOTES_COLUMN_NAME), departmentData.notes === undefined ? undefined : String(departmentData.notes).trim()]];
    let changed = false;
    if (values.forEach(([index, value]) => {
      index !== -1 && value !== undefined && String(currentRow[index]) !== String(value) && (currentRow[index] = value, changed = true);
    }), changed && (range.setValues([currentRow]), SpreadsheetApp.flush()), newName !== oldName) renameDepartmentEverywhere(oldName, newName);
    return {
      success: true,
      updated: changed
    };
  } catch (err) {
    return console.error("Error updating department:", err), {
      success: false,
      error: "Lỗi khi cập nhật phòng: " + err.message
    };
  } finally {
    lock.releaseLock();
  }
}
/**
 * Đổi tên phòng ở mọi nơi đang lưu theo tên. Hiện là cột Phòng của sheet Người dùng;
 * GĐ2 thêm cột Phòng cho Công việc thì bổ sung vào mảng targets.
 */
function renameDepartmentEverywhere(oldName, newName) {
  var licenseKey = getLicenseState();
  if (!licenseKey || !isValidLicenseKey(licenseKey) || getLicenseState.toString().length < 80) return;
  const trimmedOld = String(oldName || "").trim();
  if (!trimmedOld || trimmedOld === String(newName || "").trim()) return 0;
  const spreadsheet = SpreadsheetApp.getActiveSpreadsheet(),
    targets = [[STAFF_SHEET_NAME, STAFF_DEPARTMENT_COLUMN_NAME]];
  let count = 0;
  return targets.forEach(([sheetName, columnName]) => {
    const sheet = spreadsheet.getSheetByName(sheetName);
    if (!sheet || sheet.getLastRow() < 2) return;
    const headers = getHeaders(sheet),
      columnIndex = headers.indexOf(columnName);
    if (columnIndex === -1) return;
    const range = sheet.getRange(2, columnIndex + 1, sheet.getLastRow() - 1, 1),
      values = range.getValues();
    let changed = false;
    values.forEach(row => {
      String(row[0] || "").trim() === trimmedOld && (row[0] = newName, changed = true, count++);
    }), changed && range.setValues(values);
  }), SpreadsheetApp.flush(), count;
}
/** Xoá phòng. Chặn nếu vẫn còn người thuộc phòng đó — tránh để dữ liệu treo. */
function deleteDepartment(departmentId) {
  var licenseKey = getLicenseState();
  if (!licenseKey || !isValidLicenseKey(licenseKey) || getLicenseState.toString().length < 80) return;
  const lock = LockService.getScriptLock();
  try {
    lock.waitLock(15000);
    const spreadsheet = SpreadsheetApp.getActiveSpreadsheet(),
      sheet = spreadsheet.getSheetByName(DEPARTMENT_SHEET_NAME);
    if (!sheet) return {
      success: false,
      error: "Không tìm thấy sheet \"" + DEPARTMENT_SHEET_NAME + "\"."
    };
    const headers = getHeaders(sheet),
      foundRow = findRowById(sheet, headers.indexOf(DEPT_ID_COLUMN_NAME) + 1, departmentId);
    if (!foundRow) return {
      success: false,
      error: "Không tìm thấy phòng: " + departmentId
    };
    const name = String(sheet.getRange(foundRow.rowNumber, 1, 1, headers.length).getValues()[0][headers.indexOf(DEPT_NAME_COLUMN_NAME)] || "").trim(),
      staffInDept = (getStaffList() || []).filter(item => String(item[STAFF_DEPARTMENT_COLUMN_NAME] || "").trim() === name);
    if (staffInDept.length > 0) return {
      success: false,
      error: "Còn " + staffInDept.length + " người thuộc phòng \"" + name + "\". Chuyển họ sang phòng khác trước khi xoá."
    };
    return sheet.deleteRow(foundRow.rowNumber), SpreadsheetApp.flush(), {
      success: true
    };
  } catch (err) {
    return console.error("Error deleting department:", err), {
      success: false,
      error: "Lỗi khi xoá phòng: " + err.message
    };
  } finally {
    lock.releaseLock();
  }
}
function addDepartmentWithAuth(departmentData) {
  var licenseKey = getLicenseState();
  if (!licenseKey || !isValidLicenseKey(licenseKey) || getLicenseState.toString().length < 80) return;
  const permission = checkUserPermission("create", "department");
  if (!permission.success) return permission;
  return addDepartment(departmentData);
}
function updateDepartmentWithAuth(departmentId, departmentData) {
  var licenseKey = getLicenseState();
  if (!licenseKey || !isValidLicenseKey(licenseKey) || getLicenseState.toString().length < 80) return;
  const permission = checkUserPermission("update", "department");
  if (!permission.success) return permission;
  return updateDepartment(departmentId, departmentData);
}
function deleteDepartmentWithAuth(departmentId) {
  var licenseKey = getLicenseState();
  if (!licenseKey || !isValidLicenseKey(licenseKey) || getLicenseState.toString().length < 80) return;
  const permission = checkUserPermission("delete", "department");
  if (!permission.success) return permission;
  return deleteDepartment(departmentId);
}

// ===== GĐ0: chuyển đổi dữ liệu một lần =====
/** Thêm các cột còn thiếu vào cuối sheet đã tồn tại. Trả về mảng tên cột vừa thêm. */
function ensureColumns(sheet, columns) {
  var licenseKey = getLicenseState();
  if (!licenseKey || !isValidLicenseKey(licenseKey) || getLicenseState.toString().length < 80) return;
  if (!sheet) return [];
  const headers = getHeaders(sheet),
    missing = columns.filter(item => !headers.includes(item));
  if (missing.length === 0) return [];
  const startColumn = headers.length + 1,
    range = sheet.getRange(1, startColumn, 1, missing.length);
  return range.setValues([missing]), range.setFontWeight("bold"), range.setBackground("#f8f9fa"), missing;
}
/**
 * Chạy MỘT LẦN trong Apps Script editor, sau khi đã tạo bản sao file Google Sheets.
 * Chạy lại nhiều lần không hỏng: mỗi bước đều kiểm tra trước khi ghi.
 *
 * 1. Thêm cột mới vào Người dùng / Dự án-Nhiệm vụ / Nhiệm vụ (thêm vào cuối, không chèn giữa).
 * 2. Tạo sheet Phòng + 4 phòng mặc định.
 * 3. Dữ liệu cũ: Nhiệm vụ -> Cấp 3, Công việc và Nhiệm vụ -> Đã duyệt.
 * 4. Dò Họ tên -> Email điền các cột email mới; tên trùng hoặc không thấy thì bỏ trống và
 *    ghi vào log để sửa tay.
 */
function migrateV2() {
  const spreadsheet = SpreadsheetApp.getActiveSpreadsheet(),
    report = [];
  // --- bước 1: thêm cột ---
  const staffSheet = spreadsheet.getSheetByName(STAFF_SHEET_NAME),
    projectSheet = spreadsheet.getSheetByName(PROJECT_SHEET_NAME),
    taskSheet = spreadsheet.getSheetByName(TASK_SHEET_NAME);
  if (!staffSheet || !projectSheet) return console.error("Thiếu sheet bắt buộc. Có: " + spreadsheet.getSheets().map(item => item.getName()).join(", ")), "DỪNG: thiếu sheet";
  report.push("Người dùng thêm cột: " + (ensureColumns(staffSheet, [STAFF_DEPARTMENT_COLUMN_NAME, STAFF_DEPT_ROLE_COLUMN_NAME]).join(", ") || "(đã có đủ)"));
  report.push("Dự án/Nhiệm vụ thêm cột: " + (ensureColumns(projectSheet, NEW_PROJECT_COLUMNS).join(", ") || "(đã có đủ)"));
  // File thật không có sheet "Nhiệm vụ": nhiệm vụ nằm trong cột "Nhiệm vụ JSON" của sheet
  // Dự án/Nhiệm vụ. Sheet rời chỉ xử lý nếu tồn tại, để script chạy được cho cả hai kiểu.
  report.push(taskSheet ? "Nhiệm vụ thêm cột: " + (ensureColumns(taskSheet, NEW_TASK_COLUMNS).join(", ") || "(đã có đủ)") : "Không có sheet \"" + TASK_SHEET_NAME + "\" — nhiệm vụ nằm trong cột \"" + PROJECT_TASKS_JSON_COLUMN_NAME + "\", xử lý ở bước 3.");
  SpreadsheetApp.flush();
  // --- bước 2: sheet Phòng ---
  const deptSheet = getOrCreateSheet(spreadsheet, DEPARTMENT_SHEET_NAME, DEPARTMENT_HEADERS);
  seedDefaultDepartments(deptSheet), report.push("Sheet Phòng: " + (getDepartmentNames() || []).join(" | "));
  // --- bước 3 + 4 ---
  report.push(migrateFillDefaults(projectSheet, taskSheet)), report.push(migrateFillTaskJson(projectSheet)), report.push(migrateFillEmails(projectSheet, taskSheet));
  const text = report.join("\n");
  return console.log(text), text;
}
/** Bước 3: điền Cấp = 3 và Trạng thái duyệt = Đã duyệt cho dữ liệu đã có từ trước. */
function migrateFillDefaults(projectSheet, taskSheet) {
  let filledLevel = 0,
    filledTaskApproval = 0,
    filledProjectApproval = 0;
  const fillColumn = (sheet, columnName, value) => {
    if (!sheet || sheet.getLastRow() < 2) return 0;
    const columnIndex = getHeaders(sheet).indexOf(columnName);
    if (columnIndex === -1) return 0;
    const range = sheet.getRange(2, columnIndex + 1, sheet.getLastRow() - 1, 1),
      values = range.getValues();
    let count = 0;
    return values.forEach(row => {
      String(row[0] || "").trim() === "" && (row[0] = value, count++);
    }), count > 0 && range.setValues(values), count;
  };
  return filledLevel = fillColumn(taskSheet, TASK_LEVEL_COLUMN_NAME, LEVEL_TASK), filledTaskApproval = fillColumn(taskSheet, TASK_APPROVAL_COLUMN_NAME, APPROVAL_APPROVED), filledProjectApproval = fillColumn(projectSheet, PROJECT_APPROVAL_COLUMN_NAME, APPROVAL_APPROVED), SpreadsheetApp.flush(), "Điền mặc định: Cấp=3 cho " + filledLevel + " nhiệm vụ, Đã duyệt cho " + filledTaskApproval + " nhiệm vụ và " + filledProjectApproval + " công việc";
}
/** Bảng tra Họ tên -> Email từ sheet Người dùng. Tên trùng nhau ghi vào duplicated. */
function buildStaffNameEmailMap() {
  const byName = {},
    duplicated = {};
  return (getStaffList() || []).forEach(item => {
    const name = String(item[STAFF_NAME_COLUMN_NAME] || "").trim(),
      email = normalizeEmail(item[STAFF_EMAIL_COLUMN_NAME]);
    if (!name || !email) return;
    byName[name] === undefined ? byName[name] = email : byName[name] !== email && (duplicated[name] = true);
  }), {
    byName: byName,
    duplicated: duplicated
  };
}
/**
 * Bước 3b: nhiệm vụ thật nằm trong cột "Nhiệm vụ JSON" của sheet Dự án/Nhiệm vụ, mỗi công
 * việc một mảng JSON. Thêm Cấp = 3, Mã cha = "", Trạng thái duyệt = Đã duyệt và
 * Email người thực hiện cho từng phần tử. Chạy lại nhiều lần không ghi thêm gì.
 */
function migrateFillTaskJson(projectSheet) {
  if (!projectSheet || projectSheet.getLastRow() < 2) return "Nhiệm vụ JSON: chưa có công việc nào.";
  const headers = getHeaders(projectSheet),
    jsonIndex = headers.indexOf(PROJECT_TASKS_JSON_COLUMN_NAME);
  if (jsonIndex === -1) return "Nhiệm vụ JSON: không tìm thấy cột \"" + PROJECT_TASKS_JSON_COLUMN_NAME + "\".";
  const map = buildStaffNameEmailMap(),
    range = projectSheet.getRange(2, jsonIndex + 1, projectSheet.getLastRow() - 1, 1),
    values = range.getValues(),
    unresolved = {};
  let filledLevel = 0,
    filledApproval = 0,
    filledEmail = 0,
    changedRows = 0,
    brokenRows = 0;
  values.forEach(row => {
    const raw = row[0];
    if (!raw || typeof raw !== "string") return;
    let list;
    try {
      list = JSON.parse(raw);
    } catch (err) {
      brokenRows++;
      return;
    }
    if (!Array.isArray(list)) return;
    let changed = false;
    list.forEach(task => {
      if (!task || typeof task !== "object") return;
      String(task[TASK_LEVEL_COLUMN_NAME] || "").trim() === "" && (task[TASK_LEVEL_COLUMN_NAME] = LEVEL_TASK, filledLevel++, changed = true);
      task[TASK_PARENT_ID_COLUMN_NAME] === undefined && (task[TASK_PARENT_ID_COLUMN_NAME] = "", changed = true);
      String(task[TASK_APPROVAL_COLUMN_NAME] || "").trim() === "" && (task[TASK_APPROVAL_COLUMN_NAME] = APPROVAL_APPROVED, filledApproval++, changed = true);
      if (String(task[TASK_ASSIGNEE_EMAIL_COLUMN_NAME] || "").trim() === "") {
        const name = String(task[TASK_ASSIGNEE_COLUMN_NAME] || "").trim();
        name && (map.duplicated[name] ? unresolved["TRÙNG TÊN: " + name] = true : map.byName[name] ? (task[TASK_ASSIGNEE_EMAIL_COLUMN_NAME] = map.byName[name], filledEmail++, changed = true) : unresolved[name] = true);
      }
    }), changed && (row[0] = formatJSONCompact(list), changedRows++);
  }), changedRows > 0 && (range.setValues(values), SpreadsheetApp.flush());
  const keys = Object.keys(unresolved);
  return "Nhiệm vụ JSON: ghi lại " + changedRows + " công việc — Cấp=3 cho " + filledLevel + " nhiệm vụ, Đã duyệt cho " + filledApproval + ", email cho " + filledEmail + "." + (brokenRows > 0 ? "\n  JSON lỗi không đọc được: " + brokenRows + " dòng." : "") + (keys.length > 0 ? "\n  CẦN SỬA TAY (" + keys.length + "): " + keys.join(" | ") : "");
}
/** Bước 4: dò Họ tên -> Email. Tên trùng nhau hoặc không có trong sheet Người dùng thì bỏ trống. */
function migrateFillEmails(projectSheet, taskSheet) {
  const map = buildStaffNameEmailMap(),
    byName = map.byName,
    duplicated = map.duplicated;
  const notFound = {},
    fillEmailColumn = (sheet, nameColumn, emailColumn) => {
      if (!sheet || sheet.getLastRow() < 2) return 0;
      const headers = getHeaders(sheet),
        nameIndex = headers.indexOf(nameColumn),
        emailIndex = headers.indexOf(emailColumn);
      if (nameIndex === -1 || emailIndex === -1) return 0;
      const range = sheet.getRange(2, 1, sheet.getLastRow() - 1, headers.length),
        values = range.getValues();
      let count = 0;
      return values.forEach(row => {
        const name = String(row[nameIndex] || "").trim();
        if (!name || String(row[emailIndex] || "").trim() !== "") return;
        if (duplicated[name]) {
          notFound["TRÙNG TÊN: " + name] = true;
          return;
        }
        byName[name] ? (row[emailIndex] = byName[name], count++) : notFound[name] = true;
      }), count > 0 && range.setValues(values), count;
    },
    filledProject = fillEmailColumn(projectSheet, PROJECT_MANAGER_COLUMN_NAME, PROJECT_MANAGER_EMAIL_COLUMN_NAME),
    filledTask = fillEmailColumn(taskSheet, TASK_ASSIGNEE_COLUMN_NAME, TASK_ASSIGNEE_EMAIL_COLUMN_NAME),
    unresolved = Object.keys(notFound);
  return SpreadsheetApp.flush(), "Điền email: " + filledProject + " công việc, " + filledTask + " nhiệm vụ." + (unresolved.length > 0 ? "\n  CẦN SỬA TAY (" + unresolved.length + "): " + unresolved.join(" | ") : "\n  Không có tên nào phải sửa tay.");
}









function getDataForUser() {
  var licenseKey = getLicenseState();
  if (!licenseKey || !isValidLicenseKey(licenseKey) || getLicenseState.toString().length < 80) return;
  try {
    const currentUser = getCurrentUser();
    if (!currentUser) return {
      success: false,
      error: "Chưa đăng nhập",
      requireLogin: true
    };
    let projects = getProjects(),
      tasks = getTasks();
    const staffList = getStaffList();
    let recentActivities = getRecentActivities();
    if (!isAdmin(currentUser)) {
      if (isManager(currentUser)) {
        const mapped2 = projects.filter(project => project[PROJECT_MANAGER_COLUMN_NAME] === currentUser.name).map(item => item[PROJECT_ID_COLUMN_NAME]);
        tasks = tasks.filter(task => {
          if (task[TASK_ASSIGNEE_COLUMN_NAME] === currentUser.name) return true;
          if (mapped2.includes(task[TASK_PROJECT_ID_COLUMN_NAME])) return true;
          return false;
        });
        const filtered = tasks.map(task => task[TASK_PROJECT_ID_COLUMN_NAME]).filter(item => item);
        projects = projects.filter(project => {
          if (project[PROJECT_MANAGER_COLUMN_NAME] === currentUser.name) return true;
          if (filtered.includes(project[PROJECT_ID_COLUMN_NAME])) return true;
          return false;
        });
      } else {
        tasks = tasks.filter(task => {
          const trimmed = String(task[TASK_ASSIGNEE_COLUMN_NAME] || "").trim();
          if (trimmed === currentUser.name) return true;
          const taskProjectId = task[TASK_PROJECT_ID_COLUMN_NAME],
            project = projects.find(project2 => project2[PROJECT_ID_COLUMN_NAME] === taskProjectId);
          return project && project[PROJECT_MANAGER_COLUMN_NAME] === currentUser.name;
        });
        const set = new Set(tasks.map(task => task[TASK_PROJECT_ID_COLUMN_NAME]).filter(item => item)),
          filteredProjects = projects.filter(project => project[PROJECT_MANAGER_COLUMN_NAME] === currentUser.name);
        filteredProjects.forEach(filteredProject => {
          set.add(filteredProject[PROJECT_ID_COLUMN_NAME]);
        }), projects = projects.filter(project => {
          const projectId = project[PROJECT_ID_COLUMN_NAME];
          return set.has(projectId);
        });
      }
      recentActivities = recentActivities.filter(recentActivity => {
        const trimmed = String(recentActivity[LOG_USER_COLUMN_NAME] || "").trim();
        return trimmed === currentUser.email || trimmed === currentUser.name;
      });
    }
    const taskStatusChartData = getTaskStatusChartData(tasks),
      summaryStats = getSummaryStats(projects, tasks);
    let staffList2 = staffList;
    if (!isAdmin(currentUser)) {
      if (isManager(currentUser)) staffList2 = staffList.filter(staffList3 => {
        const lower = String(staffList3[STAFF_ROLE_COLUMN_NAME] || "").toLowerCase();
        return !lower.includes("admin");
      });else {
        const filteredProjects = projects.filter(project => project[PROJECT_MANAGER_COLUMN_NAME] === currentUser.name);
        if (filteredProjects.length > 0) staffList2 = staffList.filter(staffList3 => {
          const lower = String(staffList3[STAFF_ROLE_COLUMN_NAME] || "").toLowerCase();
          return !lower.includes("admin");
        });else {
          const staffList3 = staffList.find(staffList4 => staffList4[STAFF_NAME_COLUMN_NAME] === currentUser.name);
          staffList2 = staffList3 ? [staffList3] : [];
        }
      }
    }
    const mapped = staffList.filter(staffList3 => String(staffList3[STAFF_ROLE_COLUMN_NAME] || "").toLowerCase().includes("admin")).map(item => item[STAFF_NAME_COLUMN_NAME]);
    return {
      success: true,
      user: currentUser,
      projects: projects,
      tasks: tasks,
      staff: isAdmin(currentUser) ? staffList : staffList2,
      adminNames: mapped,
      chartData: taskStatusChartData,
      recentActivities: recentActivities,
      summaryStats: summaryStats,
      proposals: getProposals(),
      apps: getApps()
    };
  } catch (err) {
    return console.error("Error getting data for user:", err), {
      success: false,
      error: "Lỗi khi tải dữ liệu: " + err.message
    };
  }
}
