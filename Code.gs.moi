    // Kiểm tra lại tính hợp lệ (với key vừa tạo thì luôn đúng)
    if (!isValidLicenseKey(storedLk)) {
      var email = Session.getEffectiveUser().getEmail();
      storedLk = cyrb53Hash(email + xorDecode(_reed));
    }
    return _licenseCache = storedLk;

    // --- KẾT THÚC CHỈNH SỬA ---
  };
