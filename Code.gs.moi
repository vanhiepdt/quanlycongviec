      projectSheet = spreadsheet.getSheetByName(PROJECT_SHEET_NAME);
    if (!projectSheet) return [];
    const headers = getHeaders(projectSheet),
      projectTasksJsonIndex = headers.indexOf(PROJECT_TASKS_JSON_COLUMN_NAME),
      projectIdIndex = headers.indexOf(PROJECT_ID_COLUMN_NAME);
    if (projectTasksJsonIndex === -1) return [];
    const lastRow = projectSheet.getLastRow();
    if (lastRow < 2) return [];
    let list = [];
    const range = projectSheet.getRange(2, projectTasksJsonIndex + 1, lastRow - 1, 1),
      values = range.getValues();
    return values.forEach((value, index) => {
      const value2 = value[0];
      if (value2 && typeof value2 === "string") {
        const parsed = JSON.parse(value2);
        if (Array.isArray(parsed)) {
          const value3 = projectSheet.getRange(index + 2, projectIdIndex + 1).getValue(),
            mappedParsed = parsed.map(parsed2 => ({
