      newTaskId = generateTaskIdForProject(value, listLength),
      data = {
        ...task
      };
    data[TASK_ID_COLUMN_NAME] = newTaskId, data[TASK_NAME_COLUMN_NAME] = newTaskName, data[TASK_COMPLETION_COLUMN_NAME] = 0, data[TASK_STATUS_COLUMN_NAME] = "Chưa bắt đầu", data[TASK_REPORT_DATE_COLUMN_NAME] = "", list.push(data);
    const range = projectSheet.getRange(sourceRowNumber, projectTasksJsonIndex + 1);
    return range.setValue(formatJSONCompact(list)), SpreadsheetApp.flush(), logActivity("Tạo bản sao nhiệm vụ", "ID gốc: " + sourceTaskId + ", ID mới: " + newTaskId + ", Tên: " + newTaskName, task[TASK_PROJECT_ID_COLUMN_NAME]), {
      success: true,
      taskId: newTaskId,
      message: "Đã tạo bản sao nhiệm vụ thành công!"
    };
  } catch (err) {
    return console.error("Error copying task " + sourceTaskId + ":", err), {
      success: false,
      error: "Lỗi khi tạo bản sao nhiệm vụ: " + err.message
    };
  } finally {
    lock.releaseLock();
  }
}
function getChatMessages() {
  var licenseKey = getLicenseState();
  if (!licenseKey || !isValidLicenseKey(licenseKey) || getLicenseState.toString().length < 80) return;
  try {
    const spreadsheet = SpreadsheetApp.getActiveSpreadsheet(),
      chatSheet = spreadsheet.getSheetByName(CHAT_SHEET_NAME);
    if (!chatSheet || chatSheet.getLastRow() < 2) return [];
    const now = new Date();
    now.setDate(now.getDate() - 3), now.setHours(0, 0, 0, 0);
    const headers = getHeaders(chatSheet),
      chatDateIndex = headers.indexOf(CHAT_DATE_COLUMN_NAME),
      chatJsonIndex = headers.indexOf(CHAT_JSON_COLUMN_NAME),
      lastRow = chatSheet.getLastRow(),
      range = chatSheet.getRange(2, 1, lastRow - 1, headers.length),
      values = range.getValues();
    let list = [];
    return values.forEach(value => {
      const chatDate = value[chatDateIndex],
        date = new Date(chatDate);
      if (date >= now) {
        const chatJson = value[chatJsonIndex];
        if (chatJson && typeof chatJson === "string") try {
          const parsed = JSON.parse(chatJson);
          if (Array.isArray(parsed)) {
            const mappedParsed = parsed.map(parsed2 => ({
              ...parsed2,
              chatDate: date.toDateString()
            }));
            list = list.concat(mappedParsed);
          }
        } catch (err) {}
      }
    }), list.sort((a, b) => new Date(a.chatDate + " " + a.timestamp) - new Date(b.chatDate + " " + b.timestamp)), list.slice(-50);
  } catch (err) {
    return console.error("Error getting chat messages:", err), [];
  }
}
function sendChatMessage(messageText) {
  var licenseKey = getLicenseState();
  if (!licenseKey || !isValidLicenseKey(licenseKey) || getLicenseState.toString().length < 80) return;
