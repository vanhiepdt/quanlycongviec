function getInitialDataWithAuth() {
  var licenseKey = getLicenseState();
  if (!licenseKey || !isValidLicenseKey(licenseKey) || getLicenseState.toString().length < 80) return;
  const currentUser = getCurrentUser();
  if (!currentUser) return {
    success: false,
    requireLogin: true,
    message: "Vui lòng đăng nhập để tiếp tục"
  };
  try {
    const initialDataFast = getInitialDataFast();
    let projects = initialDataFast.projects || [],
      tasks = initialDataFast.tasks || [];
    const staff = initialDataFast.staff || [];
    let recentActivities = initialDataFast.recentActivities || [];
    if (!isAdmin(currentUser)) {
      if (isManager(currentUser)) {
        const mapped2 = projects.filter(project => project[PROJECT_MANAGER_COLUMN_NAME] === currentUser.name).map(item => item[PROJECT_ID_COLUMN_NAME]);
        tasks = tasks.filter(task => {
          if (task[TASK_ASSIGNEE_COLUMN_NAME] === currentUser.name) return true;
          if (mapped2.includes(task[TASK_PROJECT_ID_COLUMN_NAME])) return true;
          return false;
        });
        const filtered = tasks.map(task => task[TASK_PROJECT_ID_COLUMN_NAME]).filter(item => item);
        projects = projects.filter(project => {
          if (project[PROJECT_MANAGER_COLUMN_NAME] === currentUser.name) return true;
          if (filtered.includes(project[PROJECT_ID_COLUMN_NAME])) return true;
          return false;
        });
      } else {
        tasks = tasks.filter(task => {
          const trimmed = String(task[TASK_ASSIGNEE_COLUMN_NAME] || "").trim();
          if (trimmed === currentUser.name) return true;
          const taskProjectId = task[TASK_PROJECT_ID_COLUMN_NAME],
            project = projects.find(project2 => project2[PROJECT_ID_COLUMN_NAME] === taskProjectId);
          return project && project[PROJECT_MANAGER_COLUMN_NAME] === currentUser.name;
        });
        const set = new Set(tasks.map(task => task[TASK_PROJECT_ID_COLUMN_NAME]).filter(item => item)),
          filteredProjects = projects.filter(project => project[PROJECT_MANAGER_COLUMN_NAME] === currentUser.name);
        filteredProjects.forEach(filteredProject => {
          set.add(filteredProject[PROJECT_ID_COLUMN_NAME]);
        }), projects = projects.filter(project => {
          const projectId = project[PROJECT_ID_COLUMN_NAME];
          return set.has(projectId);
        });
      }
      recentActivities = recentActivities.filter(recentActivity => {
        const trimmed = String(recentActivity[LOG_USER_COLUMN_NAME] || "").trim();
        return trimmed === currentUser.email || trimmed === currentUser.name;
      });
    }
    let staff2 = staff;
    if (!isAdmin(currentUser)) {
      if (isManager(currentUser)) staff2 = staff.filter(staff3 => {
        const lower = String(staff3[STAFF_ROLE_COLUMN_NAME] || "").toLowerCase();
        return !lower.includes("admin");
      });else {
        const filteredProjects = projects.filter(project => project[PROJECT_MANAGER_COLUMN_NAME] === currentUser.name);
        if (filteredProjects.length > 0) staff2 = staff.filter(staff3 => {
          const lower = String(staff3[STAFF_ROLE_COLUMN_NAME] || "").toLowerCase();
          return !lower.includes("admin");
        });else {
          const staff3 = staff.find(staff4 => staff4[STAFF_NAME_COLUMN_NAME] === currentUser.name);
          staff2 = staff3 ? [staff3] : [];
        }
      }
    }
    const mapped = staff.filter(staff3 => String(staff3[STAFF_ROLE_COLUMN_NAME] || "").toLowerCase().includes("admin")).map(item => item[STAFF_NAME_COLUMN_NAME]);
    return {
      success: true,
      user: currentUser,
      projects: projects,
      tasks: tasks,
      staff: staff2,
      adminNames: mapped,
      chartData: initialDataFast.chartData,
      recentActivities: recentActivities,
      summaryStats: initialDataFast.summaryStats,
      proposals: initialDataFast.proposals || getProposals(),
      apps: initialDataFast.apps || getApps()
    };
  } catch (err) {
    return console.error("Error in fast load:", err), getDataForUser();
  }
}
function checkUserPermission(action, entityType, row = null) {
  var licenseKey = getLicenseState();
  if (!licenseKey || !isValidLicenseKey(licenseKey) || getLicenseState.toString().length < 80) return;
  const currentUser = getCurrentUser();
  if (!currentUser) return {
    success: false,
    error: "Chưa đăng nhập"
  };
  if (isAdmin(currentUser)) return {
    success: true
  };
  if (entityType === "department") return {
    success: false,
    error: "Chỉ admin mới có thể cấu hình phòng"
  };
  // GĐ1: Phó Giám đốc phụ trách phòng — toàn quyền trên công việc/nhiệm vụ trong các phòng
  // mình phụ trách. Khi có row thì siết theo cột Phòng; chưa có cột (dữ liệu cũ) thì cho qua.
  if (isDeputyDirector(currentUser)) switch (entityType) {
    case "project":
    case "task":
      {
        const department = row && typeof row === "object" ? String(row[PROJECT_DEPARTMENT_COLUMN_NAME] || "").trim() : "";
        if (!department || canAccessDepartment(currentUser, department)) return {
          success: true
        };
        return {
          success: false,
          error: "Bạn chỉ phụ trách các phòng: " + (getDepartmentsManagedBy(currentUser.email) || []).join(", ")
        };
      }
    case "staff":
      return {
        success: false,
        error: "Chỉ admin mới có thể quản lý nhân viên"
      };
    case "notification":
      return {
        success: false,
        error: "Chỉ admin mới có thể quản lý thông báo"
      };
  }
  // GĐ1: Trưởng phòng và Phó phòng — quyền như nhau (quyết định số 5). Được tạo và sửa
  // công việc/nhiệm vụ của phòng mình; trạng thái Chờ duyệt sẽ do GĐ4 gắn.
  if (isDepartmentHead(currentUser)) switch (entityType) {
    case "project":
    case "task":
      {
        const department = row && typeof row === "object" ? String(row[PROJECT_DEPARTMENT_COLUMN_NAME] || "").trim() : "";
        if (!department || canAccessDepartment(currentUser, department)) return {
          success: true
        };
        return {
          success: false,
          error: "Bạn chỉ quản lý được công việc của phòng mình"
        };
      }
    case "staff":
      return {
        success: false,
        error: "Chỉ admin mới có thể quản lý nhân viên"
      };
    case "notification":
      return {
        success: false,
        error: "Chỉ admin mới có thể quản lý thông báo"
      };
  }
  if (isManager(currentUser)) switch (entityType) {
    case "project":
      return {
        success: true
      };
    case "task":
      return {
        success: true
      };
    case "staff":
      return {
        success: false,
        error: "Chỉ admin mới có thể quản lý nhân viên"
      };
    case "notification":
      return {
        success: false,
        error: "Chỉ admin mới có thể quản lý thông báo"
      };
  }
  switch (entityType) {
    case "project":
      if (row) {
        if (row[PROJECT_MANAGER_COLUMN_NAME] === currentUser.name) return {
          success: true
        };
      } else {
        if (action === "create") return {
          success: false,
          error: "Chỉ admin và quản lý mới có thể tạo dự án mới"
        };else {
          const projects = getProjects(),
            project = projects.find(project2 => project2[PROJECT_ID_COLUMN_NAME] === row);
          if (project && project[PROJECT_MANAGER_COLUMN_NAME] === currentUser.name) return {
            success: true
          };
        }
      }
      return {
        success: false,
        error: "Bạn chỉ có thể quản lý dự án do bạn phụ trách"
      };
    case "task":
      if (action === "create") {
        const projects = getProjects(),
          filteredProjects = projects.filter(project => project[PROJECT_MANAGER_COLUMN_NAME] === currentUser.name);
        if (filteredProjects.length > 0) return {
          success: true
        };
        const filtered = getTasks().filter(item => item[TASK_ASSIGNEE_COLUMN_NAME] === currentUser.name);
        if (filtered.length > 0) return {
          success: true
        };
        return {
          success: false,
          error: "Bạn chỉ có thể tạo nhiệm vụ trong các dự án mà bạn đã được giao việc"
        };
      }
      if (action === "update" || action === "delete") {
        if (row) {
          const taskProjectId = row[TASK_PROJECT_ID_COLUMN_NAME],
            projects = getProjects(),
            project = projects.find(project2 => project2[PROJECT_ID_COLUMN_NAME] === taskProjectId);
          if (project && project[PROJECT_MANAGER_COLUMN_NAME] === currentUser.name) return {
            success: true
          };
        }
        if (row && row[TASK_ASSIGNEE_COLUMN_NAME] === currentUser.name) return {
          success: true
        };
        return {
          success: false,
          error: "Bạn chỉ có thể chỉnh sửa nhiệm vụ của mình hoặc nhiệm vụ trong dự án bạn quản lý"
        };
      }
      break;
    case "staff":
      return {
        success: false,
        error: "Chỉ admin mới có thể quản lý nhân viên"
      };
    case "notification":
      return {
        success: false,
        error: "Chỉ admin mới có thể quản lý thông báo"
      };
  }
  return {
    success: false,
    error: "Không có quyền thực hiện hành động này"
  };
}
function getInitialData() {
  var licenseKey = getLicenseState();
  if (!licenseKey || !isValidLicenseKey(licenseKey) || getLicenseState.toString().length < 80) return;
  try {
    const projects = getProjects(),
      tasks = getTasks(),
      staffList = getStaffList(),
      taskStatusChartData = getTaskStatusChartData(tasks),
      recentActivities = getRecentActivities(),
      summaryStats = getSummaryStats(projects, tasks);
    return {
      projects: projects,
      tasks: tasks,
      staff: staffList,
      chartData: taskStatusChartData,
      recentActivities: recentActivities,
      summaryStats: summaryStats
    };
  } catch (err) {
    return console.error("Error in getInitialData:", err), {
      error: "Không thể tải dữ liệu ban đầu. Chi tiết: " + err.message
    };
  }
}
function addProject(projectData) {
  var licenseKey = getLicenseState();
  if (!licenseKey || !isValidLicenseKey(licenseKey) || getLicenseState.toString().length < 80) return;
  const lock = LockService.getScriptLock();
  try {
    lock.waitLock(15000);
    const currentUser = getCurrentUser();
    !isAdmin(currentUser) && isManager(currentUser) && (projectData.manager = currentUser.name);
    const spreadsheet = SpreadsheetApp.getActiveSpreadsheet(),
      projectSheet = getOrCreateSheet(spreadsheet, PROJECT_SHEET_NAME, [PROJECT_ID_COLUMN_NAME, PROJECT_NAME_COLUMN_NAME, PROJECT_DESC_COLUMN_NAME, PROJECT_MANAGER_COLUMN_NAME, PROJECT_START_DATE_COLUMN_NAME, PROJECT_END_DATE_COLUMN_NAME, PROJECT_STATUS_COLUMN_NAME, PROJECT_TASKS_JSON_COLUMN_NAME, PROJECT_ACTIVITY_LOG_JSON_COLUMN_NAME]),
      headers = getHeaders(projectSheet);
    if (!projectData || !projectData.name || String(projectData.name).trim() === "") return {
      success: false,
      error: "Tên dự án là bắt buộc."
    };
    const projectIdIndex = headers.indexOf(PROJECT_ID_COLUMN_NAME),
      lastId = getLastId(projectSheet, projectIdIndex, "DA"),
      newId = generateNextId(lastId, "DA"),
      row = Array(headers.length).fill("");
    return row[projectIdIndex] = newId, row[headers.indexOf(PROJECT_NAME_COLUMN_NAME)] = String(projectData.name).trim(), row[headers.indexOf(PROJECT_DESC_COLUMN_NAME)] = projectData.description ? String(projectData.description).trim() : "", row[headers.indexOf(PROJECT_MANAGER_COLUMN_NAME)] = projectData.manager ? String(projectData.manager).trim() : "", row[headers.indexOf(PROJECT_START_DATE_COLUMN_NAME)] = parseDate(projectData.startDate), row[headers.indexOf(PROJECT_END_DATE_COLUMN_NAME)] = parseDate(projectData.endDate), row[headers.indexOf(PROJECT_STATUS_COLUMN_NAME)] = projectData.status || "Chưa bắt đầu", projectSheet.appendRow(row), SpreadsheetApp.flush(), logActivity("Thêm dự án", "Tên: " + projectData.name + ", Quản lý: " + (projectData.manager || "N/A") + ", ID: " + newId), {
      success: true,
      projectId: newId
    };
  } catch (err) {
    return console.error("Error adding project:", err), {
      success: false,
      error: "Lỗi khi thêm dự án: " + err.message
    };
  } finally {
    lock.releaseLock();
  }
}
function updateProject(projectId, projectData) {
  var licenseKey = getLicenseState();
  if (!licenseKey || !isValidLicenseKey(licenseKey) || getLicenseState.toString().length < 80) return;
  const lock = LockService.getScriptLock();
  try {
    lock.waitLock(15000);
    const spreadsheet = SpreadsheetApp.getActiveSpreadsheet(),
      projectSheet = spreadsheet.getSheetByName(PROJECT_SHEET_NAME);
    if (!projectSheet) throw new Error("Không tìm thấy sheet \"" + PROJECT_SHEET_NAME + "\".");
    const headers = getHeaders(projectSheet),
      projectIdIndex = headers.indexOf(PROJECT_ID_COLUMN_NAME);
    if (projectIdIndex === -1) throw new Error("Không tìm thấy cột \"" + PROJECT_ID_COLUMN_NAME + "\".");
    if (!projectId) return {
      success: false,
      error: "ID dự án không được cung cấp."
    };
    if (!projectData || !projectData.name || String(projectData.name).trim() === "") return {
      success: false,
      error: "Tên dự án là bắt buộc."
    };
    const foundRow = findRowById(projectSheet, projectIdIndex + 1, projectId);
    if (!foundRow) return {
      success: false,
      error: "Không tìm thấy dự án ID: " + projectId
    };
    const rowNumber = foundRow.rowNumber,
      range = projectSheet.getRange(rowNumber, 1, 1, headers.length),
      currentRow = range.getValues()[0];
    let flag = false;
    const values = [[headers.indexOf(PROJECT_NAME_COLUMN_NAME), projectData.name], [headers.indexOf(PROJECT_DESC_COLUMN_NAME), projectData.description], [headers.indexOf(PROJECT_MANAGER_COLUMN_NAME), projectData.manager], [headers.indexOf(PROJECT_START_DATE_COLUMN_NAME), parseDate(projectData.startDate)], [headers.indexOf(PROJECT_END_DATE_COLUMN_NAME), parseDate(projectData.endDate)], [headers.indexOf(PROJECT_STATUS_COLUMN_NAME), projectData.status]];
    return values.forEach(([value, value2]) => {
      if (value !== -1 && value2 !== undefined) {
        const value22 = value2 instanceof Date || value2 === null ? value2 : String(value2).trim();
        currentRow[value] !== value22 && (currentRow[value] = value22, flag = true);
      }
    }), flag && (range.setValues([currentRow]), SpreadsheetApp.flush(), logActivity("Cập nhật dự án", "ID: " + projectId + ", Tên: " + projectData.name)), {
      success: true,
      updated: flag
    };
  } catch (err) {
    return console.error("Error updating project " + projectId + ":", err), {
      success: false,
      error: "Lỗi khi cập nhật dự án: " + err.message
    };
  } finally {
    lock.releaseLock();
  }
}
function deleteProject(projectId) {
  var licenseKey = getLicenseState();
  if (!licenseKey || !isValidLicenseKey(licenseKey) || getLicenseState.toString().length < 80) return;
  const lock = LockService.getScriptLock();
  try {
    lock.waitLock(15000);
    const spreadsheet = SpreadsheetApp.getActiveSpreadsheet(),
      projectSheet = spreadsheet.getSheetByName(PROJECT_SHEET_NAME);
    if (!projectSheet) throw new Error("Không tìm thấy sheet \"" + PROJECT_SHEET_NAME + "\".");
    const headers = getHeaders(projectSheet),
      projectIdIndex = headers.indexOf(PROJECT_ID_COLUMN_NAME);
    if (projectIdIndex === -1) throw new Error("Không tìm thấy cột \"" + PROJECT_ID_COLUMN_NAME + "\".");
    if (!projectId) return {
      success: false,
      error: "ID dự án không được cung cấp."
    };
    const foundRow = findRowById(projectSheet, projectIdIndex + 1, projectId);
    if (!foundRow) return {
      success: false,
      error: "Không tìm thấy dự án ID: " + projectId
    };
    const rowNumber = foundRow.rowNumber,
      projectIndex = headers.indexOf(PROJECT_NAME_COLUMN_NAME),
      value = projectIndex !== -1 ? projectSheet.getRange(rowNumber, projectIndex + 1).getValue() : projectId;
    return projectSheet.deleteRow(rowNumber), logActivity("Xóa dự án", "ID: " + projectId + ", Tên: " + value), {
      success: true
    };
  } catch (err) {
    return console.error("Error deleting project " + projectId + ":", err), {
      success: false,
      error: "Lỗi khi xóa dự án: " + err.message
    };
  } finally {
    lock.releaseLock();
  }
}
function getProjects() {
  var licenseKey = getLicenseState();
  if (!licenseKey || !isValidLicenseKey(licenseKey) || getLicenseState.toString().length < 80) return;
  try {
    const spreadsheet = SpreadsheetApp.getActiveSpreadsheet(),
      projectSheet = spreadsheet.getSheetByName(PROJECT_SHEET_NAME);
    if (!projectSheet) return [];
    return sheetDataToObjectArray(projectSheet);
  } catch (err) {
    return console.error("Error getting projects:", err), [];
  }
}
// ===== GĐ2: tiện ích cho cây 3 tầng nằm trong mảng "Nhiệm vụ JSON" =====
// Nhắc lại kiến trúc: KHÔNG có sheet Nhiệm vụ rời. Cấp 2 (Công việc con) và Cấp 3
// (Nhiệm vụ) nằm CÙNG một mảng JSON của đúng dòng công việc, phân biệt bằng "Cấp" và
// "Mã cha". Vì vậy mọi phép kiểm tra cha–con chỉ cần một lần đọc ô JSON đó.

/** Cấp của một phần tử JSON, luôn trả về SỐ 2 hoặc 3. Thiếu hoặc rác => 3 (Nhiệm vụ). */
function getTaskLevel(task) {
  return task && Number(task[TASK_LEVEL_COLUMN_NAME]) === LEVEL_SUBWORK ? LEVEL_SUBWORK : LEVEL_TASK;
}
/** Mã cha của một phần tử JSON, luôn trả về chuỗi đã trim. Thiếu => "". */
function getTaskParentId(task) {
  return task ? String(task[TASK_PARENT_ID_COLUMN_NAME] || "").trim() : "";
}
/**
 * Bơm mặc định GĐ2 vào một phần tử JSON TRƯỚC KHI trả về frontend.
 * Trả về bản COPY — không sửa mảng gốc, vì các hàm ghi dùng lại đúng mảng đó.
 *
 * - "Cấp" luôn là SỐ 2 hoặc 3. Dữ liệu chưa chạy migrateV2 (thiếu khoá) và dữ liệu lưu
 *   dạng chuỗi ("3") đều về Number, nên frontend so sánh `=== 3` được mà không phải ép kiểu.
 * - "Mã cha" luôn là chuỗi đã trim. Cấp 2 bị ép về "" vì cấp 2 không có cha.
 * - "Mã dự án" bơm theo dòng công việc đang đọc, để cả cấp 2 và cấp 3 đều trỏ về gốc.
 */
function normalizeTaskForOutput(task, projectId) {
  const data = {
      ...task
    },
    level = getTaskLevel(task);
  data[TASK_LEVEL_COLUMN_NAME] = level;
  data[TASK_PARENT_ID_COLUMN_NAME] = level === LEVEL_SUBWORK ? "" : getTaskParentId(task);
  if (projectId !== undefined) data[TASK_PROJECT_ID_COLUMN_NAME] = projectId;
  return data;
}
/** Đọc mảng "Nhiệm vụ JSON" từ giá trị một ô. Rỗng hoặc JSON hỏng => [] (không throw). */
function parseTaskJson(value) {
  if (!value || typeof value !== "string" || value.trim() === "") return [];
  try {
    const parsed = JSON.parse(value);
    return Array.isArray(parsed) ? parsed : [];
  } catch (err) {
    return [];
  }
}
/** Tìm một phần tử trong mảng JSON theo Mã nhiệm vụ. */
function findTaskInList(list, taskId) {
  const wanted = String(taskId || "").trim();
  if (!wanted) return null;
  for (let i = 0; i < list.length; i++) {
    if (list[i] && String(list[i][TASK_ID_COLUMN_NAME] || "").trim() === wanted) return list[i];
  }
  return null;
}
/** Mã của mọi phần tử đang nhận taskId làm cha (con trực tiếp). */
function findTaskChildIds(list, taskId) {
  const wanted = String(taskId || "").trim();
  if (!wanted) return [];
  return list.filter(item => getTaskParentId(item) === wanted).map(item => String(item[TASK_ID_COLUMN_NAME] || "").trim()).filter(item => item !== "");
}
/**
 * Mã của MỌI con cháu của taskId trong cùng mảng JSON (không gồm chính nó).
 * Dùng cho xoá đệ quy ở deleteTask.
 *
 * Duyệt theo tầng (BFS) thay vì gọi đệ quy: không tràn stack, và `seen` chặn lặp vô hạn nếu
 * dữ liệu cũ đã trỏ vòng sẵn (A là cha B, B là cha A). Cây chỉ có 3 tầng nên thực tế chạy
 * đúng 1 vòng, nhưng viết tổng quát để đổi cấp về sau không phải sửa lại.
 */
function collectTaskDescendantIds(list, taskId) {
  const start = String(taskId || "").trim();
  if (!start) return [];
  const result = [],
    seen = {};
  seen[start] = true;
  let frontier = [start],
    guard = 0;
  while (frontier.length > 0 && guard++ < 100) {
    const next = [];
    frontier.forEach(parentId => {
      findTaskChildIds(list, parentId).forEach(childId => {
        if (seen[childId]) return;
        seen[childId] = true;
        result.push(childId);
        next.push(childId);
      });
    });
    frontier = next;
  }
  return result;
}
/**
 * Kiểm Mã cha đề xuất. Trả { ok: true, parentId } hoặc { ok: false, error }.
 *
 * - Cấp 2 bắt buộc để trống — cấp 2 là gốc cây con, dự án không có tầng thứ 4.
 * - Cấp 3 để trống là hợp lệ: nhiệm vụ nằm thẳng trong công việc (toàn bộ dữ liệu cũ
 *   sau migrateV2 đều ở dạng này).
 * - Cấp 3 có Mã cha thì mã đó phải là một phần tử CẤP 2 trong CÙNG mảng.
 * - Không được trỏ vào chính mình, cũng không được trỏ vào con cháu của chính mình
 *   (đi ngược lên theo Mã cha để chặn vòng lặp; có bộ đếm chống dữ liệu đã hỏng sẵn).
 */
function validateTaskParent(list, level, parentId, selfId) {
  const cleanParent = String(parentId === undefined || parentId === null ? "" : parentId).trim(),
    self = String(selfId || "").trim();
  if (level === LEVEL_SUBWORK) {
    if (cleanParent === "") return {
      ok: true,
      parentId: ""
    };
    return {
      ok: false,
      error: "Công việc con (Cấp 2) không được có \"" + TASK_PARENT_ID_COLUMN_NAME + "\" — nó nằm trực tiếp trong công việc."
    };
  }
  if (cleanParent === "") return {
    ok: true,
    parentId: ""
  };
  if (self && cleanParent === self) return {
    ok: false,
    error: "Không thể đặt chính nhiệm vụ này làm công việc con cha của nó."
  };
  const parent = findTaskInList(list, cleanParent);
  if (!parent) return {
    ok: false,
    error: "Không tìm thấy công việc con có mã \"" + cleanParent + "\" trong công việc này."
  };
  if (getTaskLevel(parent) !== LEVEL_SUBWORK) return {
    ok: false,
    error: "\"" + cleanParent + "\" là Nhiệm vụ (Cấp 3), không thể làm cha. Chỉ Công việc con (Cấp 2) mới nhận con."
  };
  let cursor = parent,
    guard = 0;
  while (cursor && guard++ < 500) {
    const cursorParent = getTaskParentId(cursor);
    if (cursorParent === "") break;
    if (self && cursorParent === self) return {
      ok: false,
      error: "Trỏ vòng lặp: \"" + cleanParent + "\" đang là con cháu của \"" + self + "\"."
    };
    cursor = findTaskInList(list, cursorParent);
  }
  return {
    ok: true,
    parentId: cleanParent
  };
}
/** Email theo Họ tên trong sheet Người dùng. Tên trùng nhau hoặc không thấy => "". */
function resolveStaffEmailByName(name) {
  const clean = String(name || "").trim();
  if (!clean) return "";
  const map = buildStaffNameEmailMap();
  return map.duplicated[clean] ? "" : map.byName[clean] || "";
}
/** Ép "% hoàn thành" về số nguyên 0–100. Rỗng / không phải số => 0 (giữ hành vi cũ). */
function parseTaskCompletion(value) {
  if (value === undefined || value === null || value === "") return 0;
  const num = parseInt(value, 10);
  return isNaN(num) ? 0 : Math.max(0, Math.min(100, num));
}
/**
 * Email người thực hiện sau khi sửa. Dùng chung cho 2 nhánh của updateTask.
 *
 * - Frontend gửi thẳng `assigneeEmail` thì tin dùng luôn.
 * - Họ tên KHÔNG đổi: giữ email cũ. Quan trọng vì buildStaffNameEmailMap đọc cả sheet
 *   Người dùng — tra lại mỗi lần sửa là tốn quota vô ích; và email cũ có thể đã được sửa
 *   tay trong sheet, tra lại sẽ ghi đè mất.
 * - Họ tên ĐỔI: tra lại theo tên mới. Tên trùng nhau hoặc không có trong sheet thì trả ""
 *   chứ KHÔNG giữ email cũ — email cũ là của người khác, giữ lại là gán sai người.
 */
function resolveTaskAssigneeEmail(task, taskData) {
  if (taskData && taskData.assigneeEmail !== undefined && taskData.assigneeEmail !== null && String(taskData.assigneeEmail).trim() !== "") return normalizeEmail(taskData.assigneeEmail);
  const oldName = String(task && task[TASK_ASSIGNEE_COLUMN_NAME] || "").trim(),
    oldEmail = normalizeEmail(task && task[TASK_ASSIGNEE_EMAIL_COLUMN_NAME] || ""),
    newName = taskData && taskData.assignee ? String(taskData.assignee).trim() : "";
  if (newName === "") return "";
  if (newName === oldName) return oldEmail !== "" ? oldEmail : resolveStaffEmailByName(newName);
  return resolveStaffEmailByName(newName);
}
/**
 * Ghi các trường form sửa được vào một phần tử JSON, tại chỗ.
 *
 * KHÔNG chạm "Mã nhiệm vụ", "Cấp", "Mã cha", "Email người thực hiện" và các khoá duyệt —
 * những khoá đó do updateTask tự quyết định SAU khi kiểm hợp lệ. Nhờ vậy form gửi thiếu
 * khoá cũng không làm mất dữ liệu cây 3 tầng.
 */
function applyTaskFieldsFromInput(task, taskData) {
  task[TASK_NAME_COLUMN_NAME] = String(taskData.name).trim();
  task[TASK_DESC_COLUMN_NAME] = taskData.description ? String(taskData.description).trim() : "";
  task[TASK_ASSIGNEE_COLUMN_NAME] = taskData.assignee ? String(taskData.assignee).trim() : "";
  task[TASK_PRIORITY_COLUMN_NAME] = taskData.priority || "Trung bình";
  task[TASK_START_DATE_COLUMN_NAME] = formatSheetDate(parseDate(taskData.startDate));
  task[TASK_DUE_DATE_COLUMN_NAME] = formatSheetDate(parseDate(taskData.dueDate));
  task[TASK_STATUS_COLUMN_NAME] = taskData.status || "Chưa bắt đầu";
  task[TASK_COMPLETION_COLUMN_NAME] = parseTaskCompletion(taskData.completion);
  task[TASK_REPORT_DATE_COLUMN_NAME] = formatSheetDate(parseDate(taskData.reportDate));
  task[TASK_TARGET_COLUMN_NAME] = taskData.target ? String(taskData.target).trim() : "";
  task[TASK_RESULT_LINKS_COLUMN_NAME] = taskData.resultLinks ? String(taskData.resultLinks).trim() : "";
  task[TASK_OUTPUT_COLUMN_NAME] = taskData.output ? String(taskData.output).trim() : "";
  task[TASK_NOTES_COLUMN_NAME] = taskData.notes ? String(taskData.notes).trim() : "";
  if (!task[TASK_REMINDERS_COLUMN_NAME]) task[TASK_REMINDERS_COLUMN_NAME] = [];
  return task;
}
function addTask(taskData) {
  var licenseKey = getLicenseState();
  if (!licenseKey || !isValidLicenseKey(licenseKey) || getLicenseState.toString().length < 80) return;
  const lock = LockService.getScriptLock();
  try {
    lock.waitLock(15000);
    const spreadsheet = SpreadsheetApp.getActiveSpreadsheet(),
      projectSheet = spreadsheet.getSheetByName(PROJECT_SHEET_NAME);
    if (!projectSheet) throw new Error("Không tìm thấy sheet \"" + PROJECT_SHEET_NAME + "\".");
    const headers = getHeaders(projectSheet),
      projectTasksJsonIndex = headers.indexOf(PROJECT_TASKS_JSON_COLUMN_NAME),
      projectIdIndex = headers.indexOf(PROJECT_ID_COLUMN_NAME);
    if (projectTasksJsonIndex === -1) throw new Error("Không tìm thấy cột \"" + PROJECT_TASKS_JSON_COLUMN_NAME + "\".");
    if (!taskData || !taskData.name || String(taskData.name).trim() === "") return {
      success: false,
      error: "Tên nhiệm vụ là bắt buộc."
    };
    if (!taskData.projectId || String(taskData.projectId).trim() === "") return {
      success: false,
      error: "Nhiệm vụ phải thuộc về một dự án."
    };
    const foundRow = findRowById(projectSheet, projectIdIndex + 1, taskData.projectId);
    if (!foundRow) return {
      success: false,
