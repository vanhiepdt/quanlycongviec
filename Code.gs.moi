  } finally {
    lock.releaseLock();
  }
}
function updateStaff(staffId, staffData) {
  var licenseKey = getLicenseState();
  if (!licenseKey || !isValidLicenseKey(licenseKey) || getLicenseState.toString().length < 80) return;
  const lock = LockService.getScriptLock();
  try {
    lock.waitLock(15000);
    const spreadsheet = SpreadsheetApp.getActiveSpreadsheet(),
      staffSheet = spreadsheet.getSheetByName(STAFF_SHEET_NAME);
    if (!staffSheet) throw new Error("Không tìm thấy sheet \"" + STAFF_SHEET_NAME + "\".");
    const headers = getHeaders(staffSheet),
      staffIdIndex = headers.indexOf(STAFF_ID_COLUMN_NAME);
    if (staffIdIndex === -1) throw new Error("Không tìm thấy cột \"" + STAFF_ID_COLUMN_NAME + "\".");
    if (!staffId) return {
      success: false,
      error: "ID nhân viên không được cung cấp."
    };
    if (!staffData || !staffData.name || String(staffData.name).trim() === "") return {
      success: false,
      error: "Tên nhân viên là bắt buộc."
    };
    const foundRow = findRowById(staffSheet, staffIdIndex + 1, staffId);
    if (!foundRow) return {
      success: false,
      error: "Không tìm thấy nhân viên ID: " + staffId
    };
    const rowNumber = foundRow.rowNumber,
      range = staffSheet.getRange(rowNumber, 1, 1, headers.length),
      currentRow = range.getValues()[0];
    let flag = false;
    const values = [[headers.indexOf(STAFF_NAME_COLUMN_NAME), staffData.name], [headers.indexOf(STAFF_EMAIL_COLUMN_NAME), staffData.email], [headers.indexOf(STAFF_POSITION_COLUMN_NAME), staffData.position], [headers.indexOf(STAFF_ROLE_COLUMN_NAME), staffData.role], [headers.indexOf(STAFF_PASSWORD_COLUMN_NAME), staffData.password], [headers.indexOf(STAFF_OBJECT_TYPE_COLUMN_NAME), staffData.objectType], [headers.indexOf(STAFF_NOTES_COLUMN_NAME), staffData.notes], [headers.indexOf(STAFF_DEPARTMENT_COLUMN_NAME), staffData.department], [headers.indexOf(STAFF_DEPT_ROLE_COLUMN_NAME), staffData.deptRole]];
    return values.forEach(([value, value2]) => {
      if (value !== -1 && value2 !== undefined) {
        const trimmed = value2 ? String(value2).trim() : "";
        String(currentRow[value]).trim() !== trimmed && (currentRow[value] = trimmed, flag = true);
      }
    }), flag && (range.setValues([currentRow]), SpreadsheetApp.flush()), {
      success: true,
      updated: flag
    };
  } catch (err) {
    return console.error("Error updating staff " + staffId + ":", err), {
      success: false,
      error: "Lỗi khi cập nhật nhân viên: " + err.message
    };
  } finally {
    lock.releaseLock();
  }
}
function deleteStaff(staffId) {
