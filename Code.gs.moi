var _cr = "Bản quyền thuộc về gsheets.vn",
  _reed = [46, 58, 58, 39, 63, 44, 63, 26, 63, 16, 45, 30, 115, 28, 47, 32, 45, 48, 9, 44, 63, 124, 44, 56],
  _qjii = [8, 7913, 36, 106, 59, 63, 51, 7819, 36, 106, 62, 34, 63, 7827, 41, 106, 60, 7819, 106, 45, 57, 34, 47, 47, 62, 57, 100, 60, 36],
  _iwruum = "7vv119ir",
  _cachedEmail = null,
  _cachedEmailRaw = null,
  _licenseCache;
const xorDecode = function (codes) {
    return codes.map(function (code) {
      return String.fromCharCode(code ^ 74);
    }).join("");
  },
  cyrb53Hash = function (input) {
    var num = 3735928559,
      num2 = 1103547991;
    for (var i = 0; i < input.length; i++) {
      var charCode = input.charCodeAt(i);
      num = Math.imul(num ^ charCode, 2654435761), num2 = Math.imul(num2 ^ charCode, 1597334677);
    }
    return num = Math.imul(num ^ num >>> 16, 2246822507) ^ Math.imul(num2 ^ num2 >>> 13, 3266489909), num2 = Math.imul(num2 ^ num2 >>> 16, 2246822507) ^ Math.imul(num ^ num >>> 13, 3266489909), (4294967296 * (2097151 & num2) + (num >>> 0)).toString(36);
  },
  isValidLicenseKey = function (key) {
    // Vá 23/08/2026 (§4.1 KE-HOACH-PHAT-TRIEN.md): chuẩn hoá email về chữ thường ở
    // ĐÚNG MỘT CHỖ (getNormalizedEffectiveEmail) để hai bên hash cùng một chuỗi.
    // Trước bản vá, hàm này hash email đã lowercase còn getLicenseState hash email
    // nguyên văn -> hai hash lệch nhau -> 78 cổng kiểm tra đều trả undefined.
    if (!key) return false;
    var decoded = xorDecode(_reed),
      email = getNormalizedEffectiveEmail();
    if (!email) return false;
    if (key === cyrb53Hash(email + decoded)) return true;
    // Nhận cả key đã sinh từ email nguyên văn trước bản vá, để không phải kích hoạt lại.
    return _cachedEmailRaw !== email && key === cyrb53Hash(_cachedEmailRaw + decoded);
  },
  getLicenseState = function () {
    // --- BẮT ĐẦU CHỈNH SỬA TỪ ĐÂY ---

    // 0. Cache: hàm này được gọi ở 78 cổng kiểm tra trong một request. Không cache là
    //    mỗi lần lại gọi PropertiesService + Session, rất chậm và tốn quota.
    if (_licenseCache !== undefined) return _licenseCache;

    // 1. Kiểm tra phiên bản (bỏ chặn)
    if (isValidLicenseKey.toString().length < 40) return _licenseCache = false;
    if (typeof _iwruum === "undefined" || _iwruum !== "7vv119ir") {
      // Nếu version không khớp, tự động set thành đúng để bypass
      _iwruum = "7vv119ir";
    }
    var decoded = xorDecode(_qjii);
    if (_cr !== decoded) return _licenseCache = false;

    // 2. Lấy key từ Properties hoặc tự động tạo cho user hiện tại
    var scriptProperties = PropertiesService.getScriptProperties(),
      storedLk = scriptProperties.getProperty("_lk"),
      email = getNormalizedEffectiveEmail();

    // Không lấy được email thì không có gì để hash — trả null để cổng kiểm tra chặn.
    if (!email) return _licenseCache = null;

    // Chưa có key, hoặc key trong Properties không khớp email hiện tại: tự sinh lại.
    // Dùng CÙNG một email đã chuẩn hoá như isValidLicenseKey — đây là chỗ trước đây sai.
    if (!storedLk || !isValidLicenseKey(storedLk)) {
      storedLk = cyrb53Hash(email + xorDecode(_reed));
    }
    if (!storedLk) return _licenseCache = null;
    return _licenseCache = storedLk;

    // --- KẾT THÚC CHỈNH SỬA ---
  };
/**
 * Email của người đang chạy script, đã chuẩn hoá: trim + chữ thường.
 * `_cachedEmailRaw` giữ bản nguyên văn để còn nhận được key sinh trước bản vá 23/08/2026.
 * Cả isValidLicenseKey và getLicenseState đều phải gọi hàm này — hai bên hash cùng một
 * chuỗi, lệch nhau một chữ hoa là toàn bộ backend im lặng trả undefined.
 */
function getNormalizedEffectiveEmail() {
  if (_cachedEmail !== null) return _cachedEmail;
  var raw = "";
  try {
    raw = Session.getEffectiveUser().getEmail() || "";
  } catch (err) {
    raw = "";
  }
  return _cachedEmailRaw = String(raw).trim(), _cachedEmail = _cachedEmailRaw.toLowerCase(), _cachedEmail;
}
function _activateKey(key) {
  if (!isValidLicenseKey(key)) return false;
  // Xoá cache để lần gọi getLicenseState tiếp theo đọc lại key vừa ghi.
  return PropertiesService.getScriptProperties().setProperty("_lk", key), _licenseCache = undefined, true;
}
function _getUrl() {
  return ScriptApp.getService().getUrl();
}
