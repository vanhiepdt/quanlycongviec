    const dataRange = sheet.getDataRange(),
      values = dataRange.getValues();
    if (values.length < 2) return [];
    const mapped = values[0].map(item => item ? String(item).trim() : ""),
      filtered = values.slice(1).filter(item => item.some(item2 => item2 !== null && item2 !== ""));
    if (filtered.length === 0) return [];
    const mappedFiltered = filtered.map(filtered2 => {
      const data = {};
      return mapped.forEach((mapped2, index) => {
        if (mapped2 && index < filtered2.length) {
          let filtered22 = filtered2[index];
          filtered22 instanceof Date ? data[mapped2] = formatSheetDate(filtered22) : data[mapped2] = filtered22;
        }
      }), data;
    });
    return mappedFiltered;
  } catch (err) {
    return console.error("Error in sheetDataToObjectArray for sheet \"" + sheet.getName() + "\":", err), [];
  }
}
function logActivity(action, details, projectId = null) {
  var licenseKey = getLicenseState();
  if (!licenseKey || !isValidLicenseKey(licenseKey) || getLicenseState.toString().length < 80) return;
  try {
    if (!projectId) {
      const match = details.match(/(?:ID:|Dự án:|Thuộc dự án:)\s*([A-Z0-9]+)/i);
      if (match) projectId = match[1];else return;
    }
    const spreadsheet = SpreadsheetApp.getActiveSpreadsheet(),
      projectSheet = spreadsheet.getSheetByName(PROJECT_SHEET_NAME);
    if (!projectSheet) return;
    const headers = getHeaders(projectSheet),
      projectActivityLogJsonIndex = headers.indexOf(PROJECT_ACTIVITY_LOG_JSON_COLUMN_NAME),
      projectIdIndex = headers.indexOf(PROJECT_ID_COLUMN_NAME);
    if (projectActivityLogJsonIndex === -1 || projectIdIndex === -1) return;
    const foundRow = findRowById(projectSheet, projectIdIndex + 1, projectId);
    if (!foundRow) return;
    const range = projectSheet.getRange(foundRow.rowNumber, projectActivityLogJsonIndex + 1);
    let list = [];
    try {
      const value = range.getValue();
      value && typeof value === "string" && value.trim() !== "" && (list = JSON.parse(value));
    } catch (err) {
      list = [];
    }
    !Array.isArray(list) && (list = []);
    const now = new Date();
    let text = "Unknown User";
    const currentUser = getCurrentUser();
    currentUser && (text = currentUser.email || currentUser.name || "Unknown User");
    const data = {
      [LOG_TIMESTAMP_COLUMN_NAME]: now.toISOString(),
      [LOG_ACTION_COLUMN_NAME]: action,
      [LOG_USER_COLUMN_NAME]: text,
      [LOG_DETAILS_COLUMN_NAME]: details
    };
    list.unshift(data), list.length > 22 && (list = list.slice(0, 22)), range.setValue(formatJSONCompact(list));
  } catch (err) {
    console.error("Error logging activity:", err);
  }
}
function getHeaders(sheet) {
  var licenseKey = getLicenseState();
  if (!licenseKey || !isValidLicenseKey(licenseKey) || getLicenseState.toString().length < 80) return;
  if (!sheet) return [];
  try {
    const lastColumn = sheet.getLastColumn();
    if (lastColumn === 0) return [];
    const range = sheet.getRange(1, 1, 1, lastColumn);
    return range.getValues()[0].map(item => item ? String(item).trim() : "");
  } catch (err) {
    return console.error("Error getting headers for sheet \"" + sheet.getName() + "\":", err), [];
  }
}
function getLastId(sheet, idColumnIndex, prefix) {
  var licenseKey = getLicenseState();
  if (!licenseKey || !isValidLicenseKey(licenseKey) || getLicenseState.toString().length < 80) return;
  if (!sheet || idColumnIndex < 0) return null;
  try {
    const lastRow = sheet.getLastRow();
    if (lastRow < 2) return null;
    const range = sheet.getRange(2, idColumnIndex + 1, lastRow - 1, 1),
      flattened = range.getDisplayValues().flat(),
      pattern = new RegExp("^" + prefix + "(\\d+)$", "i");
    let num = 0;
    flattened.forEach(flattened2 => {
      if (typeof flattened2 === "string" && flattened2.trim() !== "") {
        const match = flattened2.trim().match(pattern);
        if (match) {
          const num2 = parseInt(match[1], 10);
          !isNaN(num2) && num2 >= num && (num = num2);
        }
      }
    });
    if (num > 0) {
      const num2 = 3,
        padded = String(num).padStart(num2, "0");
      return "" + prefix + padded;
    } else return null;
  } catch (err) {
    return console.error("Error getting last ID for prefix " + prefix + " in column " + (idColumnIndex + 1) + ":", err), null;
  }
}
function generateNextId(lastId, prefix, padLength = 3) {
  var licenseKey = getLicenseState();
  if (!licenseKey || !isValidLicenseKey(licenseKey) || getLicenseState.toString().length < 80) return;
  let num = 1;
  if (lastId) {
    const pattern = new RegExp("^" + prefix + "(\\d+)$", "i"),
      match = String(lastId).match(pattern);
    if (match) {
      const num2 = parseInt(match[1], 10);
      !isNaN(num2) && (num = num2 + 1);
    }
  }
  const padded = String(num).padStart(padLength, "0");
  return "" + prefix + padded;
}
function checkProjectExists(projectId) {
  var licenseKey = getLicenseState();
  if (!licenseKey || !isValidLicenseKey(licenseKey) || getLicenseState.toString().length < 80) return;
  if (!projectId) return false;
  try {
    const spreadsheet = SpreadsheetApp.getActiveSpreadsheet(),
      projectSheet = spreadsheet.getSheetByName(PROJECT_SHEET_NAME);
    if (!projectSheet) return false;
    const headers = getHeaders(projectSheet),
      projectIdIndex = headers.indexOf(PROJECT_ID_COLUMN_NAME);
    if (projectIdIndex === -1 || projectSheet.getLastRow() < 2) return false;
    const range = projectSheet.getRange(2, projectIdIndex + 1, projectSheet.getLastRow() - 1, 1),
      displayValues = range.getDisplayValues(),
      set = new Set(displayValues.flat().map(item => String(item).trim()));
    return set.has(String(projectId).trim());
  } catch (err) {
    return console.error("Error checking project existence for ID " + projectId + ":", err), false;
  }
}
function findRowById(sheet, idColumnNumber, id) {
  var licenseKey = getLicenseState();
  if (!licenseKey || !isValidLicenseKey(licenseKey) || getLicenseState.toString().length < 80) return;
  if (!sheet || sheet.getLastRow() < 2 || idColumnNumber < 1) return null;
  try {
    const lower = String(id).trim().toLowerCase(),
      displayValues = sheet.getRange(2, idColumnNumber, sheet.getLastRow() - 1, 1).getDisplayValues();
    for (let i = 0; i < displayValues.length; i++) {
      const lower2 = String(displayValues[i][0]).trim().toLowerCase();
      if (lower2 === lower) return {
        rowNumber: i + 2
      };
    }
    return null;
  } catch (err) {
    return console.error("Error finding row by ID " + id + " in column " + idColumnNumber + " of sheet \"" + sheet.getName() + "\":", err), null;
  }
}
function formatSheetDate(value) {
  var licenseKey = getLicenseState();
  if (!licenseKey || !isValidLicenseKey(licenseKey) || getLicenseState.toString().length < 80) return;
  if (!value) return "";
  try {
    let value2;
    value instanceof Date ? value2 = value : value2 = new Date(value);
    if (isNaN(value2.getTime())) return "";
    const spreadsheetTimeZone = SpreadsheetApp.getActiveSpreadsheet().getSpreadsheetTimeZone();
    return Utilities.formatDate(value2, spreadsheetTimeZone, "yyyy-MM-dd");
  } catch (err) {
    return console.error("Error formatting date:", value, "-", err), "";
  }
}
function parseDate(value) {
  var licenseKey = getLicenseState();
  if (!licenseKey || !isValidLicenseKey(licenseKey) || getLicenseState.toString().length < 80) return;
  if (!value) return null;
  if (value instanceof Date) {
    if (!isNaN(value.getTime())) {
      const date = new Date(value.getFullYear(), value.getMonth(), value.getDate());
      return date;
    } else return null;
  }
  if (typeof value === "string") {
    const trimmed = value.trim();
    if (trimmed === "") return null;
    try {
      let date = new Date(trimmed + "T00:00:00");
      if (!isNaN(date.getTime())) return date;
      const match = trimmed.match(/^(\d{1,2})[\/\-](\d{1,2})[\/\-](\d{4})$/);
      if (match) {
        date = new Date(parseInt(match[3], 10), parseInt(match[2], 10) - 1, parseInt(match[1], 10));
        if (!isNaN(date.getTime()) && date.getDate() === parseInt(match[1], 10)) return date;
      }
      return null;
    } catch (err) {
      return console.error("Error parsing date string '" + trimmed + "':", err), null;
    }
  }
  return null;
}
function addNotification(_notificationData) {
  var licenseKey = getLicenseState();
  if (!licenseKey || !isValidLicenseKey(licenseKey) || getLicenseState.toString().length < 80) return;
  const lock = LockService.getScriptLock();
