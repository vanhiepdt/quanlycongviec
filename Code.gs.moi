    };
    const range = projectSheet.getRange(foundRow.rowNumber, projectTasksJsonIndex + 1),
      list = parseTaskJson(range.getValue()),
      // GĐ2: 2 = Công việc con, 3 = Nhiệm vụ. Không truyền level => 3, đúng như hành vi cũ.
      level = Number(taskData.level) === LEVEL_SUBWORK ? LEVEL_SUBWORK : LEVEL_TASK,
      parentCheck = validateTaskParent(list, level, taskData.parentId, null);
    if (!parentCheck.ok) return {
      success: false,
      error: parentCheck.error
    };
    const newTaskId = generateTaskIdForProject(taskData.projectId, list.length),
      data = {};
    data[TASK_ID_COLUMN_NAME] = newTaskId, data[TASK_NAME_COLUMN_NAME] = String(taskData.name).trim(), data[TASK_DESC_COLUMN_NAME] = taskData.description ? String(taskData.description).trim() : "", data[TASK_ASSIGNEE_COLUMN_NAME] = taskData.assignee ? String(taskData.assignee).trim() : "", data[TASK_STATUS_COLUMN_NAME] = taskData.status || "Chưa bắt đầu", data[TASK_PRIORITY_COLUMN_NAME] = taskData.priority || "Trung bình", data[TASK_START_DATE_COLUMN_NAME] = formatSheetDate(parseDate(taskData.startDate)), data[TASK_DUE_DATE_COLUMN_NAME] = formatSheetDate(parseDate(taskData.dueDate));
    let num = 0;
    if (taskData.completion !== undefined && taskData.completion !== null && taskData.completion !== "") {
      const num2 = parseInt(taskData.completion, 10);
      !isNaN(num2) && (num = Math.max(0, Math.min(100, num2)));
    }
    data[TASK_COMPLETION_COLUMN_NAME] = num;
    data[TASK_REPORT_DATE_COLUMN_NAME] = formatSheetDate(parseDate(taskData.reportDate));
    data[TASK_TARGET_COLUMN_NAME] = taskData.target ? String(taskData.target).trim() : "";
    data[TASK_RESULT_LINKS_COLUMN_NAME] = taskData.resultLinks ? String(taskData.resultLinks).trim() : "";
    data[TASK_OUTPUT_COLUMN_NAME] = taskData.output ? String(taskData.output).trim() : "";
    data[TASK_NOTES_COLUMN_NAME] = taskData.notes ? String(taskData.notes).trim() : "";
    data[TASK_REMINDERS_COLUMN_NAME] = [];
    // GĐ2: hai khoá quyết định cây 3 tầng. Ghi cả khi Cấp 3 để dữ liệu mới không phụ
    // thuộc vào việc getTasks có bơm mặc định hay không.
    data[TASK_LEVEL_COLUMN_NAME] = level;
    data[TASK_PARENT_ID_COLUMN_NAME] = parentCheck.parentId;
    // Khoá email (GĐ1). Trạng thái duyệt đặt "Đã duyệt" cho khớp dữ liệu sau migrateV2;
    // GĐ4 mới đổi thành "Chờ duyệt" khi người tạo là Trưởng/Phó phòng.
    data[TASK_ASSIGNEE_EMAIL_COLUMN_NAME] = taskData.assigneeEmail ? normalizeEmail(taskData.assigneeEmail) : resolveStaffEmailByName(taskData.assignee);
    data[TASK_APPROVAL_COLUMN_NAME] = APPROVAL_APPROVED;
    list.push(data);
    range.setValue(formatJSONCompact(list));
    SpreadsheetApp.flush();
    logActivity(level === LEVEL_SUBWORK ? "Thêm công việc con" : "Thêm nhiệm vụ", "Tên: " + taskData.name + ", Giao cho: " + (taskData.assignee || "N/A") + ", ID: " + newTaskId + (parentCheck.parentId ? ", thuộc công việc con: " + parentCheck.parentId : ""), taskData.projectId);
    return {
      success: true,
      taskId: newTaskId,
      level: level,
      parentId: parentCheck.parentId
    };
  } catch (err) {
    return console.error("Error adding task:", err), {
      success: false,
      error: "Lỗi khi thêm nhiệm vụ: " + err.message
    };
  } finally {
    lock.releaseLock();
  }
}
function updateTask(taskId, taskData) {
  var licenseKey = getLicenseState();
  if (!licenseKey || !isValidLicenseKey(licenseKey) || getLicenseState.toString().length < 80) return;
  const lock = LockService.getScriptLock();
  try {
    lock.waitLock(15000);
    const spreadsheet = SpreadsheetApp.getActiveSpreadsheet(),
      projectSheet = spreadsheet.getSheetByName(PROJECT_SHEET_NAME);
    if (!projectSheet) throw new Error("Không tìm thấy sheet \"" + PROJECT_SHEET_NAME + "\".");
    const headers = getHeaders(projectSheet),
      projectTasksJsonIndex = headers.indexOf(PROJECT_TASKS_JSON_COLUMN_NAME),
      projectIdIndex = headers.indexOf(PROJECT_ID_COLUMN_NAME);
    if (projectTasksJsonIndex === -1) throw new Error("Không tìm thấy cột \"" + PROJECT_TASKS_JSON_COLUMN_NAME + "\".");
    const wantedId = String(taskId || "").trim();
    if (!wantedId) return {
      success: false,
      error: "ID nhiệm vụ không được cung cấp."
    };
    if (!taskData || !taskData.name || String(taskData.name).trim() === "") return {
      success: false,
      error: "Tên nhiệm vụ là bắt buộc."
    };
    if (!taskData.projectId || String(taskData.projectId).trim() === "") return {
      success: false,
      error: "Nhiệm vụ phải thuộc về một dự án."
    };
    const lastRow = projectSheet.getLastRow();
    if (lastRow < 2) return {
      success: false,
      error: "Không tìm thấy nhiệm vụ."
    };
    const values = projectSheet.getRange(2, 1, lastRow - 1, headers.length).getValues(),
      targetProjectId = String(taskData.projectId).trim();
    let sourceRowNumber = null,
      sourceProjectId = "",
      taskIndex = -1,
      list = [];
    for (let i = 0; i < values.length; i++) {
      const parsed = parseTaskJson(values[i][projectTasksJsonIndex]);
      if (parsed.length === 0) continue;
      const parsedIndex = parsed.findIndex(item => item && String(item[TASK_ID_COLUMN_NAME] || "").trim() === wantedId);
      if (parsedIndex === -1) continue;
      sourceRowNumber = i + 2;
      sourceProjectId = projectIdIndex === -1 ? "" : String(values[i][projectIdIndex] || "").trim();
      taskIndex = parsedIndex;
      list = parsed;
      break;
    }
    if (!sourceRowNumber) return {
      success: false,
      error: "Không tìm thấy nhiệm vụ ID: " + wantedId
    };
    const task = list[taskIndex],
      level = getTaskLevel(task),
      childIds = findTaskChildIds(list, wantedId),
      // Tính TRƯỚC khi applyTaskFieldsFromInput ghi đè "Người thực hiện": hàm này cần so
      // họ tên cũ với họ tên mới để quyết định có tra lại sheet Người dùng hay không.
      nextAssigneeEmail = resolveTaskAssigneeEmail(task, taskData);
    // GĐ2 — KHÔNG cho đổi "Cấp". Đổi cấp là di chuyển cây: 3 → 2 phải gỡ "Mã cha", 2 → 3
    // phải xử lý cả đàn con. Để giai đoạn sau. Báo lỗi rõ chứ không bỏ qua im lặng, để
    // frontend gửi sai còn biết mà sửa.
    if (taskData.level !== undefined && taskData.level !== null && taskData.level !== "" && Number(taskData.level) !== level) return {
      success: false,
      error: "Không thể đổi \"" + TASK_LEVEL_COLUMN_NAME + "\" của mục đã tạo (đang là " + level + ", yêu cầu " + Number(taskData.level) + "). Hãy xoá rồi tạo lại ở cấp mong muốn."
    };
    if (sourceProjectId !== targetProjectId) {
      // Chuyển sang công việc khác. Cấp 2 đang có con thì CHẶN: đàn con nằm trong mảng JSON
      // của công việc cũ, chuyển riêng cha đi là chúng thành mồ côi ngay.
      if (level === LEVEL_SUBWORK && childIds.length > 0) return {
        success: false,
        error: "Không thể chuyển \"" + (task[TASK_NAME_COLUMN_NAME] || wantedId) + "\" sang công việc khác vì đang có " + childIds.length + " nhiệm vụ con. Hãy chuyển hoặc xoá các nhiệm vụ con trước."
      };
      // Tìm dòng đích TRƯỚC khi gỡ khỏi dòng nguồn. Bản cũ gỡ trước rồi mới tìm, nên mã công
      // việc đích không tồn tại là mất hẳn nhiệm vụ — nó đã bị ghi ra khỏi sheet.
      let targetRowNumber = null,
        targetList = [];
      for (let i = 0; i < values.length; i++) {
        if (projectIdIndex === -1 || String(values[i][projectIdIndex] || "").trim() !== targetProjectId) continue;
        targetRowNumber = i + 2;
        targetList = parseTaskJson(values[i][projectTasksJsonIndex]);
        break;
      }
      if (!targetRowNumber) return {
        success: false,
        error: "Không tìm thấy dự án mới ID: " + targetProjectId
      };
      const newTaskId = generateTaskIdForProject(targetProjectId, targetList.length),
        droppedParent = getTaskParentId(task),
        // Copy cả object rồi mới ghi đè: giữ nguyên nhắc việc, trạng thái duyệt, "Cấp" và mọi
        // khoá lạ. Bản cũ dựng object mới từ danh sách trắng nên mất hết khoá GĐ1–GĐ4.
        moved = {
          ...task
        };
      applyTaskFieldsFromInput(moved, taskData);
      moved[TASK_ID_COLUMN_NAME] = newTaskId;
      moved[TASK_PROJECT_ID_COLUMN_NAME] = targetProjectId;
      moved[TASK_LEVEL_COLUMN_NAME] = level;
      // "Mã cha" chỉ có nghĩa trong mảng của MỘT công việc. Sang công việc khác thì bỏ trống,
      // nhiệm vụ nằm thẳng trong công việc mới; người dùng gán lại cha nếu muốn.
      moved[TASK_PARENT_ID_COLUMN_NAME] = "";
      moved[TASK_ASSIGNEE_EMAIL_COLUMN_NAME] = nextAssigneeEmail;
      list.splice(taskIndex, 1);
      targetList.push(moved);
      projectSheet.getRange(sourceRowNumber, projectTasksJsonIndex + 1).setValue(formatJSONCompact(list));
      projectSheet.getRange(targetRowNumber, projectTasksJsonIndex + 1).setValue(formatJSONCompact(targetList));
      SpreadsheetApp.flush();
      logActivity(level === LEVEL_SUBWORK ? "Chuyển công việc con" : "Chuyển nhiệm vụ", "ID: " + wantedId + " → " + newTaskId + ", Tên: " + moved[TASK_NAME_COLUMN_NAME] + ", Từ " + sourceProjectId + " sang " + targetProjectId + (droppedParent ? ", đã bỏ " + TASK_PARENT_ID_COLUMN_NAME + " " + droppedParent : ""), targetProjectId);
      return {
        success: true,
        updated: true,
        moved: true,
        newTaskId: newTaskId,
        level: level,
        parentId: "",
        parentCleared: droppedParent !== ""
      };
    }
    // Cùng công việc: sửa tại chỗ.
    let parentId = getTaskParentId(task);
    if (taskData.parentId !== undefined && taskData.parentId !== null) {
      // Cho đổi "Mã cha", nhưng phải qua validateTaskParent: chặn trỏ vào chính mình, trỏ vào
      // con cháu của mình (vòng lặp), trỏ vào mã không tồn tại, và chặn lấy Cấp 3 làm cha.
      const parentCheck = validateTaskParent(list, level, taskData.parentId, wantedId);
      if (!parentCheck.ok) return {
        success: false,
        error: parentCheck.error
      };
      parentId = parentCheck.parentId;
    }
    applyTaskFieldsFromInput(task, taskData);
    task[TASK_LEVEL_COLUMN_NAME] = level;
    task[TASK_PARENT_ID_COLUMN_NAME] = level === LEVEL_SUBWORK ? "" : parentId;
    task[TASK_ASSIGNEE_EMAIL_COLUMN_NAME] = nextAssigneeEmail;
    projectSheet.getRange(sourceRowNumber, projectTasksJsonIndex + 1).setValue(formatJSONCompact(list));
    SpreadsheetApp.flush();
    logActivity(level === LEVEL_SUBWORK ? "Cập nhật công việc con" : "Cập nhật nhiệm vụ", "ID: " + wantedId + ", Tên: " + task[TASK_NAME_COLUMN_NAME] + (parentId ? ", " + TASK_PARENT_ID_COLUMN_NAME + ": " + parentId : ""), targetProjectId);
    return {
      success: true,
      updated: true,
      taskId: wantedId,
      level: level,
      parentId: level === LEVEL_SUBWORK ? "" : parentId,
      childCount: childIds.length
    };
  } catch (err) {
    return console.error("Error updating task " + taskId + ":", err), {
      success: false,
      error: "Lỗi khi cập nhật nhiệm vụ: " + err.message
    };
  } finally {
    lock.releaseLock();
  }
}
function deleteTask(taskId) {
  var licenseKey = getLicenseState();
  if (!licenseKey || !isValidLicenseKey(licenseKey) || getLicenseState.toString().length < 80) return;
  const lock = LockService.getScriptLock();
  try {
    lock.waitLock(15000);
    const spreadsheet = SpreadsheetApp.getActiveSpreadsheet(),
      projectSheet = spreadsheet.getSheetByName(PROJECT_SHEET_NAME);
    if (!projectSheet) throw new Error("Không tìm thấy sheet \"" + PROJECT_SHEET_NAME + "\".");
    const headers = getHeaders(projectSheet),
      projectTasksJsonIndex = headers.indexOf(PROJECT_TASKS_JSON_COLUMN_NAME),
      projectIdIndex = headers.indexOf(PROJECT_ID_COLUMN_NAME);
    if (projectTasksJsonIndex === -1) throw new Error("Không tìm thấy cột \"" + PROJECT_TASKS_JSON_COLUMN_NAME + "\".");
    if (!taskId) return {
      success: false,
      error: "ID nhiệm vụ không được cung cấp."
    };
    const lastRow = projectSheet.getLastRow();
    if (lastRow < 2) return {
      success: false,
      error: "Không tìm thấy nhiệm vụ."
    };
    const values = projectSheet.getRange(2, 1, lastRow - 1, headers.length).getValues();
    const wantedId = String(taskId).trim();
    for (let i = 0; i < values.length; i++) {
      const list = parseTaskJson(values[i][projectTasksJsonIndex]);
      if (list.length === 0) continue;
      const targetIndex = list.findIndex(item => item && String(item[TASK_ID_COLUMN_NAME] || "").trim() === wantedId);
      if (targetIndex === -1) continue;
      const projectId = projectIdIndex === -1 ? null : values[i][projectIdIndex],
        target = list[targetIndex],
        targetName = target[TASK_NAME_COLUMN_NAME] || wantedId,
        level = getTaskLevel(target),
        // GĐ2 — XOÁ ĐỆ QUY. Xoá một Công việc con (Cấp 2) thì mọi Nhiệm vụ (Cấp 3) trỏ
        // "Mã cha" về nó phải đi theo: cấp 2 và cấp 3 nằm CÙNG mảng JSON này, để lại là
        // thành mồ côi — getWorkTree sẽ gom vào nhóm "(chưa gán công việc con)" và người
        // dùng thấy nhiệm vụ lơ lửng không hiểu từ đâu ra.
        deletedChildren = collectTaskDescendantIds(list, wantedId),
        removeSet = {};
      removeSet[wantedId] = true;
      deletedChildren.forEach(childId => removeSet[childId] = true);
      // Lọc một lượt thay vì splice nhiều lần — splice trong lúc lặp là lệch chỉ số.
      const kept = list.filter(item => !removeSet[String(item && item[TASK_ID_COLUMN_NAME] || "").trim()]);
      projectSheet.getRange(i + 2, projectTasksJsonIndex + 1).setValue(formatJSONCompact(kept));
      SpreadsheetApp.flush();
      logActivity(level === LEVEL_SUBWORK ? "Xóa công việc con" : "Xóa nhiệm vụ", "ID: " + wantedId + ", Tên: " + targetName + (deletedChildren.length > 0 ? ", xoá kèm " + deletedChildren.length + " nhiệm vụ con: " + deletedChildren.join(", ") : ""), projectId);
      // deletedChildren trả về cho frontend để nó biết đã mất thêm những gì mà cập nhật state
      // (removeOptimisticUpdate cho từng mã con) và hiện thông báo đúng số lượng.
      return {
        success: true,
        taskId: wantedId,
        level: level,
        projectId: projectId,
        deletedChildren: deletedChildren,
        deletedCount: 1 + deletedChildren.length
      };
    }
    return {
      success: false,
      error: "Không tìm thấy nhiệm vụ ID: " + taskId
    };
  } catch (err) {
    return console.error("Error deleting task " + taskId + ":", err), {
      success: false,
      error: "Lỗi khi xóa nhiệm vụ: " + err.message
    };
  } finally {
    lock.releaseLock();
  }
}
function addTaskReminder(taskId, reminderData) {
  var licenseKey = getLicenseState();
  if (!licenseKey || !isValidLicenseKey(licenseKey) || getLicenseState.toString().length < 80) return;
  const lock = LockService.getScriptLock();
  try {
    lock.waitLock(15000);
    const currentUser = getCurrentUser();
    if (!currentUser) return {
      success: false,
      error: "Chưa đăng nhập"
    };
    if (!isAdmin(currentUser)) return {
      success: false,
      error: "Chỉ Admin mới có quyền thêm nhắc việc"
    };
    if (!taskId) return {
      success: false,
      error: "ID nhiệm vụ không được cung cấp."
    };
    if (!reminderData || !reminderData.date) return {
      success: false,
      error: "Ngày nhắc là bắt buộc."
    };
    const spreadsheet = SpreadsheetApp.getActiveSpreadsheet(),
      projectSheet = spreadsheet.getSheetByName(PROJECT_SHEET_NAME);
    if (!projectSheet) throw new Error("Không tìm thấy sheet \"" + PROJECT_SHEET_NAME + "\".");
    const headers = getHeaders(projectSheet),
      projectTasksJsonIndex = headers.indexOf(PROJECT_TASKS_JSON_COLUMN_NAME);
    if (projectTasksJsonIndex === -1) throw new Error("Không tìm thấy cột \"" + PROJECT_TASKS_JSON_COLUMN_NAME + "\".");
    const lastRow = projectSheet.getLastRow();
    if (lastRow < 2) return {
      success: false,
      error: "Không tìm thấy nhiệm vụ."
    };
    const values = projectSheet.getRange(2, projectTasksJsonIndex + 1, lastRow - 1, 1).getValues();
    for (let i = 0; i < values.length; i++) {
      const value = values[i][0];
      try {
        if (value && typeof value === "string") {
          let parsed = JSON.parse(value);
          const parsedIndex = parsed.findIndex(parsed2 => parsed2[TASK_ID_COLUMN_NAME] === taskId);
          if (parsedIndex !== -1) {
            !parsed[parsedIndex][TASK_REMINDERS_COLUMN_NAME] && (parsed[parsedIndex][TASK_REMINDERS_COLUMN_NAME] = []);
            const data = {
              date: reminderData.date,
              content: reminderData.content || ""
            };
            return parsed[parsedIndex][TASK_REMINDERS_COLUMN_NAME].push(data), parsed[parsedIndex][TASK_REMINDERS_COLUMN_NAME].sort((a, b) => new Date(a.date) - new Date(b.date)), projectSheet.getRange(i + 2, projectTasksJsonIndex + 1).setValue(formatJSONCompact(parsed)), SpreadsheetApp.flush(), logActivity("Thêm nhắc việc", "Nhiệm vụ: " + parsed[parsedIndex][TASK_NAME_COLUMN_NAME] + ", Ngày: " + reminderData.date), {
              success: true,
              reminders: parsed[parsedIndex][TASK_REMINDERS_COLUMN_NAME]
            };
          }
        }
      } catch (err) {
        continue;
      }
    }
    return {
      success: false,
      error: "Không tìm thấy nhiệm vụ ID: " + taskId
    };
  } catch (err) {
    return console.error("Error adding reminder:", err), {
      success: false,
      error: "Lỗi khi thêm nhắc việc: " + err.message
    };
  } finally {
    lock.releaseLock();
  }
}
