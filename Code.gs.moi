function getSummaryStats(projects, tasks) {
  var licenseKey = getLicenseState();
  if (!licenseKey || !isValidLicenseKey(licenseKey) || getLicenseState.toString().length < 80) return;
  try {
    const projectCount = projects && Array.isArray(projects) ? projects.length : 0;
    let num = 0,
      num2 = 0,
      num3 = 0;
    // GĐ2: chỉ Cấp 3 được tính là "nhiệm vụ". Cấp 2 là nhóm — đếm nó vào đây là tổng số và
    // tiến độ đều sai. subWorkCount trả riêng để giao diện hiện "N công việc con" nếu muốn.
    const level3Tasks = filterLevel3Tasks(tasks),
      taskCount = level3Tasks.length,
      subWorkCount = tasks && Array.isArray(tasks) ? tasks.length - taskCount : 0,
      now = new Date();
    now.setHours(0, 0, 0, 0);
    const taskStatusColumnName = TASK_STATUS_COLUMN_NAME,
      taskDueDateColumnName = TASK_DUE_DATE_COLUMN_NAME;
    level3Tasks.forEach(task => {
      if (!task.hasOwnProperty(taskStatusColumnName)) return;
      const lower = String(task[taskStatusColumnName] || "").trim().toLowerCase(),
        task2 = task[taskDueDateColumnName];
      if (lower.includes("hoàn thành")) num++;else lower.includes("đang") && num2++;
      if (!lower.includes("hoàn thành") && task2) {
        const parsedDate = parseDate(task2);
        parsedDate && parsedDate < now && num3++;
      }
    });
    return {
      totalProjects: projectCount,
      totalTasks: taskCount,
      totalSubWorks: subWorkCount,
      completedTasks: num,
      ongoingTasks: num2,
      overdueTasks: num3
    };
  } catch (err) {
    return console.error("Error calculating summary stats:", err), {
      error: "Lỗi khi tính toán thống kê: " + err.message
    };
  }
}
function getRecentActivities() {
  var licenseKey = getLicenseState();
