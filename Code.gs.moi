  now.setHours(0, 0, 0, 0);
  let num = 0;
  const taskStatusColumnName = TASK_STATUS_COLUMN_NAME,
    taskDueDateColumnName = TASK_DUE_DATE_COLUMN_NAME;
  tasks.forEach(task => {
    if (typeof task !== "object" || task === null || !task.hasOwnProperty(taskStatusColumnName)) return;
    const lower = (task[taskStatusColumnName] || "").toLowerCase(),
      task2 = task[taskDueDateColumnName];
    if (!lower.includes("hoàn thành") && task2) try {
      const parsedDate = parseDate(task2);
      parsedDate && parsedDate < now && (num++, createOverdueNotificationIfNeeded(task));
    } catch (err) {
      const taskId = task[TASK_ID_COLUMN_NAME] || "Không rõ ID";
    }
  });
}
function createOverdueNotificationIfNeeded(_task) {
