function addProposal(proposal) {
  var licenseKey = getLicenseState();
  if (!licenseKey || !isValidLicenseKey(licenseKey) || getLicenseState.toString().length < 80) return;
  try {
    const spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
    let proposalSheet = spreadsheet.getSheetByName(PROPOSAL_SHEET_NAME);
    !proposalSheet && (proposalSheet = spreadsheet.insertSheet(PROPOSAL_SHEET_NAME), proposalSheet.appendRow([PROPOSAL_ID_COLUMN, PROPOSAL_TYPE_COLUMN, PROPOSAL_PROJECT_ID_COLUMN, PROPOSAL_TASK_ID_COLUMN, PROPOSAL_CONTENT_COLUMN, PROPOSAL_URL_COLUMN, PROPOSAL_SUPPLIER_COLUMN, PROPOSAL_CREATOR_COLUMN, PROPOSAL_DATE_COLUMN, PROPOSAL_STATUS_COLUMN, PROPOSAL_NOTE_COLUMN]));
    const headers = getHeaders(proposalSheet),
      proposalIdIndex = headers.indexOf(PROPOSAL_ID_COLUMN),
      lastRow = proposalSheet.getLastRow();
    let num = 0;
    if (lastRow > 1) {
      const values = proposalSheet.getRange(2, proposalIdIndex + 1, lastRow - 1, 1).getValues();
      values.forEach(value => {
        const text2 = String(value[0] || ""),
          match = text2.match(/DN(\d+)/);
        if (match) {
          const num2 = parseInt(match[1], 10);
          if (num2 > num) num = num2;
        }
      });
    }
    const text = "DN" + String(num + 1).padStart(3, "0"),
      currentUser = getCurrentUser(),
      currentUserName = currentUser ? currentUser.name : "",
      mappedHeaders = headers.map(header => {
        switch (header) {
          case PROPOSAL_ID_COLUMN:
            return text;
          case PROPOSAL_TYPE_COLUMN:
            return proposal[PROPOSAL_TYPE_COLUMN] || "Ngoài kế hoạch";
          case PROPOSAL_PROJECT_ID_COLUMN:
            return proposal[PROPOSAL_PROJECT_ID_COLUMN] || "";
          case PROPOSAL_TASK_ID_COLUMN:
            return proposal[PROPOSAL_TASK_ID_COLUMN] || "";
          case PROPOSAL_CONTENT_COLUMN:
            return proposal[PROPOSAL_CONTENT_COLUMN] || "";
          case PROPOSAL_URL_COLUMN:
            return proposal[PROPOSAL_URL_COLUMN] || "";
          case PROPOSAL_SUPPLIER_COLUMN:
            return proposal[PROPOSAL_SUPPLIER_COLUMN] || "";
          case PROPOSAL_CREATOR_COLUMN:
            return currentUserName;
          case PROPOSAL_DATE_COLUMN:
            return new Date();
          case PROPOSAL_STATUS_COLUMN:
            return proposal[PROPOSAL_STATUS_COLUMN] || "Đề xuất mới";
          case PROPOSAL_NOTE_COLUMN:
            return proposal[PROPOSAL_NOTE_COLUMN] || "";
          default:
            return "";
        }
      });
    return proposalSheet.appendRow(mappedHeaders), logActivity("Tạo đề nghị", "Đề nghị " + text + ": " + proposal[PROPOSAL_CONTENT_COLUMN]?.substring(0, 50) + "..."), {
      success: true,
      proposalId: text
    };
  } catch (err) {
    return console.error("Error adding proposal:", err), {
      success: false,
      error: "Lỗi khi tạo đề nghị: " + err.message
    };
  }
}
function updateProposal(proposalId, proposalData) {
  var licenseKey = getLicenseState();
  if (!licenseKey || !isValidLicenseKey(licenseKey) || getLicenseState.toString().length < 80) return;
  try {
    const spreadsheet = SpreadsheetApp.getActiveSpreadsheet(),
      proposalSheet = spreadsheet.getSheetByName(PROPOSAL_SHEET_NAME);
    if (!proposalSheet) return {
      success: false,
      error: "Không tìm thấy sheet Đề nghị"
    };
    const headers = getHeaders(proposalSheet),
      proposalIdIndex = headers.indexOf(PROPOSAL_ID_COLUMN),
      foundRow = findRowById(proposalSheet, proposalIdIndex + 1, proposalId);
    if (!foundRow) return {
      success: false,
      error: "Không tìm thấy đề nghị"
    };
    const values = [PROPOSAL_TYPE_COLUMN, PROPOSAL_PROJECT_ID_COLUMN, PROPOSAL_TASK_ID_COLUMN, PROPOSAL_CONTENT_COLUMN, PROPOSAL_URL_COLUMN, PROPOSAL_SUPPLIER_COLUMN, PROPOSAL_STATUS_COLUMN, PROPOSAL_NOTE_COLUMN],
      range = proposalSheet.getRange(foundRow.rowNumber, 1, 1, headers.length),
      currentRow = range.getValues()[0];
    let flag = false;
    return values.forEach(value => {
      if (proposalData[value] !== undefined) {
        const index = headers.indexOf(value);
        index !== -1 && currentRow[index] !== proposalData[value] && (currentRow[index] = proposalData[value], flag = true);
      }
    }), flag && range.setValues([currentRow]), logActivity("Cập nhật đề nghị", "Đề nghị " + proposalId), {
      success: true
    };
  } catch (err) {
    return console.error("Error updating proposal:", err), {
      success: false,
      error: "Lỗi khi cập nhật đề nghị: " + err.message
    };
  }
}
