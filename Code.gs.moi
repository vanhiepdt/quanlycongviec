function deleteTaskReminder(taskId, reminderId) {
  var licenseKey = getLicenseState();
  if (!licenseKey || !isValidLicenseKey(licenseKey) || getLicenseState.toString().length < 80) return;
  const lock = LockService.getScriptLock();
  try {
    lock.waitLock(15000);
    const currentUser = getCurrentUser();
    if (!currentUser) return {
      success: false,
      error: "Chưa đăng nhập"
    };
    if (!isAdmin(currentUser)) return {
      success: false,
      error: "Chỉ Admin mới có quyền xóa nhắc việc"
    };
    if (!taskId) return {
      success: false,
      error: "ID nhiệm vụ không được cung cấp."
    };
    if (reminderId === undefined || reminderId === null) return {
      success: false,
      error: "Chỉ số nhắc việc không hợp lệ."
    };
    const spreadsheet = SpreadsheetApp.getActiveSpreadsheet(),
      projectSheet = spreadsheet.getSheetByName(PROJECT_SHEET_NAME);
    if (!projectSheet) throw new Error("Không tìm thấy sheet \"" + PROJECT_SHEET_NAME + "\".");
    const headers = getHeaders(projectSheet),
      projectTasksJsonIndex = headers.indexOf(PROJECT_TASKS_JSON_COLUMN_NAME);
    if (projectTasksJsonIndex === -1) throw new Error("Không tìm thấy cột \"" + PROJECT_TASKS_JSON_COLUMN_NAME + "\".");
    const lastRow = projectSheet.getLastRow();
    if (lastRow < 2) return {
      success: false,
      error: "Không tìm thấy nhiệm vụ."
    };
    const values = projectSheet.getRange(2, projectTasksJsonIndex + 1, lastRow - 1, 1).getValues();
    for (let i = 0; i < values.length; i++) {
      const value = values[i][0];
      try {
        if (value && typeof value === "string") {
          let parsed = JSON.parse(value);
          const parsedIndex = parsed.findIndex(parsed2 => parsed2[TASK_ID_COLUMN_NAME] === taskId);
          if (parsedIndex !== -1) {
            const taskReminders = parsed[parsedIndex][TASK_REMINDERS_COLUMN_NAME] || [];
            if (reminderId < 0 || reminderId >= taskReminders.length) return {
              success: false,
              error: "Chỉ số nhắc việc không tồn tại."
            };
            return taskReminders.splice(reminderId, 1), parsed[parsedIndex][TASK_REMINDERS_COLUMN_NAME] = taskReminders, projectSheet.getRange(i + 2, projectTasksJsonIndex + 1).setValue(formatJSONCompact(parsed)), SpreadsheetApp.flush(), logActivity("Xóa nhắc việc", "Nhiệm vụ: " + parsed[parsedIndex][TASK_NAME_COLUMN_NAME]), {
              success: true,
              reminders: parsed[parsedIndex][TASK_REMINDERS_COLUMN_NAME]
            };
          }
        }
      } catch (err) {
        continue;
      }
    }
    return {
      success: false,
      error: "Không tìm thấy nhiệm vụ ID: " + taskId
    };
  } catch (err) {
    return console.error("Error deleting reminder:", err), {
      success: false,
      error: "Lỗi khi xóa nhắc việc: " + err.message
    };
  } finally {
    lock.releaseLock();
  }
}
function formatJSONCompact(value) {
  var licenseKey = getLicenseState();
  if (!licenseKey || !isValidLicenseKey(licenseKey) || getLicenseState.toString().length < 80) return;
  if (!Array.isArray(value) || value.length === 0) return JSON.stringify(value);
  const mappedValue = value.map(value2 => JSON.stringify(value2));
  return "[\n" + mappedValue.join(",\n") + "\n]";
}
