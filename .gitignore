# Thư viện npm của tools/ — cài lại bằng: cd tools && npm install
node_modules/

# Bản sao lưu tay — từ nay dùng git thay cho .bak
*.bak

# File tạm do tool sinh ra
temp.html
*.tmp.gs
unmapped_report.txt

# ===== Bản VPS =====

# Bí mật: mật khẩu CSDL, SESSION_SECRET, SMTP. Chỉ commit .env.example.
.env
deploy/.env
*.env.local

# Bản chụp dữ liệu thật xuất từ Google Sheets — có họ tên, email, mật khẩu thật.
# Tuyệt đối không commit.
data/*
!data/.gitkeep

# Đầu ra của test và build
coverage/
*.log

# ===== File tạm dò/vá do trợ lý AI sinh ra khi sửa lỗi — KHÔNG commit =====
# Vẫn nằm trên đĩa để tra lại; muốn lưu riêng thì: git add -f <file>
tools/_*
tools/uat-server.pid
# Bản ghi đầu ra của chay.bat / chay-test.bat khi chạy có chuyển hướng (> _kq*.txt)
_kq*.txt
server/_*
server/tools/_*

# Cấu hình editor cá nhân + file dữ liệu tải về (có thể chứa dữ liệu thật)
.vscode/
/file tai xuong tu google sheet.xlsx

# ===== File kết quả nhiệm vụ lưu trên đĩa (014) — dữ liệu người dùng, KHÔNG commit =====
server/storage/
