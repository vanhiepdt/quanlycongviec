# Mẫu biến môi trường. Chép thành `deploy/.env` rồi sửa. KHÔNG commit file .env thật.
#
#   cd deploy && cp .env.example .env
#
# 14 biến ở nhóm BẮT BUỘC: thiếu một biến là server chết ngay khi khởi động, không chạy tiếp
# với giá trị đoán (server/src/config/env.js).

# ---------------------------------------------------------------- BẮT BUỘC (14)
NODE_ENV=development
PORT=3000

# Máy dev: khớp với docker-compose.dev.yml, cổng 5432 buộc vào 127.0.0.1.
DATABASE_URL=postgres://qlcv:doi-mat-khau-nay@127.0.0.1:5432/quanlycongviec

# Ít nhất 32 ký tự. Sinh chuỗi mới: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=doi-thanh-chuoi-ngau-nhien-32-ky-tu-tro-len-truoc-khi-chay
SESSION_COOKIE_NAME=qlcv_sid
SESSION_TTL_HOURS=12
# true khi đã có HTTPS. Trên máy dev chạy http nên phải để false, không thì không đăng nhập được.
SESSION_COOKIE_SECURE=false

BCRYPT_COST=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300

LOG_LEVEL=debug
TZ=Asia/Ho_Chi_Minh

# ---------------------------------------------------------------- PRODUCTION (VPS, Phase 8)
# docker-compose.yml tự đè NODE_ENV=production và DATABASE_URL (tên db nội bộ) — KHÔNG
# cần đặt tay hai biến đó. Những biến sau phải đổi trong deploy/.env CỦA VPS so với
# mẫu dev ở trên (bí mật sinh ngẫu nhiên ≥32 ký tự, chỉ nhập trực tiếp trên VPS):
#   SESSION_COOKIE_SECURE=true           — đã có HTTPS (việc 4)
#   CRON_ENABLED=true                    — quét quá hạn + dọn chat + đẩy hàng đợi Zalo
#   LOG_LEVEL=info
#   APP_BASE_URL=https://ttdt.site
#   ZALO_BOT_NHAN=webhook + ZALO_BOT_SECRET_TOKEN (việc 6)
#   ONLYOFFICE_URL=https://office.ttdt.site
#   ONLYOFFICE_CALLBACK_BASE=http://app:3000 — container OnlyOffice gọi ngược app qua
#     TÊN dịch vụ trong mạng compose, KHÔNG phải host.docker.internal (việc 5)

# ---------------------------------------------------------------- TUỲ CHỌN
APP_BASE_URL=http://localhost:3000
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=15000
# Nhắc nhiệm vụ quá hạn — 07:00 hằng ngày (J2, thay setupDailyTrigger của Apps Script).
CRON_OVERDUE=0 7 * * *
# Dọn tin chat cũ — 03:30 Chủ nhật hằng tuần (§7 việc 7.4). Giữ 90 ngày gần nhất; khung chat trên
# giao diện chỉ hiện 3 ngày / 50 tin, phần còn lại giữ để tra lại khi cần.
CRON_CHAT_CLEANUP=30 3 * * 0
CHAT_KEEP_DAYS=90
# Bật/tắt lịch chạy trong container app (§7 việc 5.8). MẶC ĐỊNH false: staging và máy dev nối
# cùng một CSDL bản sao, hai chỗ cùng bật là mỗi người nhận hai lượt thông báo. Production đặt true.
# Cờ này che CẢ HAI lịch (quét quá hạn + dọn chat).
CRON_ENABLED=false

# Gửi email: để false đến khi có SMTP thật (§13.4 mục 4).
MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --------------------------------------------- Chỉ docker-compose.dev.yml đọc
POSTGRES_DB=quanlycongviec
POSTGRES_USER=qlcv
POSTGRES_PASSWORD=doi-mat-khau-nay
POSTGRES_PORT=5432
# 5433 hay bị dự án khác chiếm; đổi số này nếu `docker compose up` báo "port is already allocated".
POSTGRES_TEST_PORT=5434
ADMINER_PORT=8080

# CSDL cho test tự động (service db-test). `npm test` xoá bảng liên tục nên phải là CSDL riêng.
TEST_DATABASE_URL=postgres://qlcv:doi-mat-khau-nay@127.0.0.1:5434/quanlycongviec_test

# ONLYOFFICE Document Server (Vòng 14 — sửa file kết quả trực tuyến). Trống = TẮT nút «sửa».
# Máy dev (docker run onlyoffice/documentserver, cổng 80): URL trỏ DS cho TRÌNH DUYỆT; secret phải# đúng JWT_SECRET của container; CALLBACK_BASE là địa chỉ mà DS container gọi NGƯỢC về app.
ONLYOFFICE_URL=http://localhost
ONLYOFFICE_JWT_SECRET=doi-thanh-secret-cua-ban
ONLYOFFICE_CALLBACK_BASE=http://host.docker.internal:3000

# ZALO BOT — đẩy thông báo phê duyệt sang Zalo (017, docs/KE-HOACH-THONG-BAO.md).
# Trống = TẮT HẲN: không gọi mạng, không hiện khối «Thông báo Zalo» trên trang Quản lý tài khoản.
#
# Lấy token: mở app Zalo → tìm OA «Zalo Bot Manager» → menu chat chọn «Tạo bot» → tên bot phải bắt
# đầu bằng tiền tố «Bot» → token được gửi cho bạn qua tin nhắn Zalo. Kiểm bằng:
#   npm run zalo:kiem
# ⚠ TOKEN NẰM TRONG ĐƯỜNG DẪN của mọi lời gọi API (/bot<token>/sendMessage) — ai có nó là điều khiển
#   được bot. File này (deploy/.env) đã bị .gitignore chặn; ĐỪNG dán token vào .env.example hay
#   vào tài liệu.
ZALO_BOT_TOKEN=

# Cách NHẬN tin người dùng nhắn cho bot: tat | polling | webhook
#  · polling — chạy được NGAY trên PC, KHÔNG cần domain. Dùng cho giai đoạn hiện tại (§13.4 mục 2).
#    Ô webhook ở trang Bot Creator phải để TRỐNG, vì đặt webhook là getUpdates ngừng hoạt động.
#  · webhook — cần domain công khai + HTTPS. Tài liệu Zalo TỪ CHỐI localhost/127.0.0.1/192.168.x.x/
#    10.x.x.x. Bật ở Phase 8, hoặc dùng ngrok/Cloudflare Tunnel nếu muốn thử sớm.
ZALO_BOT_NHAN=tat

# Chỉ cần khi ZALO_BOT_NHAN=webhook. PHẢI TRÙNG giá trị bạn nhập ở trang Zalo Bot Creator, 8–256 ký
# tự. Zalo gắn nó vào header X-Bot-Api-Secret-Token của mọi request gọi về hệ thống của bạn.
ZALO_BOT_SECRET_TOKEN=

# Đổi khi Zalo dời tên miền, hoặc trỏ vào máy chủ giả để thử. Mặc định đủ dùng.
ZALO_BOT_API_BASE=https://bot-api.zaloplatforms.com

# Lịch đẩy hàng đợi (đi cùng cờ CRON_ENABLED, không có cờ riêng) và tuổi tối đa của thông báo được
# đẩy — container tắt ba ngày rồi bật lại không được dội một tràng tin cũ.
CRON_ZALO_PUSH=*/2 * * * *
ZALO_PUSH_MAX_AGE_H=24
