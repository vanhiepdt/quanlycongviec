{
  "name": "quanlycongviec-server",
  "version": "0.1.0",
  "private": true,
  "description": "Máy chủ quản lý công việc — bản VPS (Node + Express + PostgreSQL)",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node-pg-migrate --migrations-dir src/db/migrations --migration-file-language sql --envPath ../deploy/.env",
    "migrate:up": "npm run migrate -- up",
    "migrate:down": "npm run migrate -- down 1",
    "migrate:redo": "npm run migrate:down && npm run migrate:up",
    "seed:dev": "node src/db/seeds/run.js dev.sql",
    "import:sheets": "node src/modules/import/cli.js",
    "import:sheets:dry": "node src/modules/import/cli.js --dry-run",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "coverage": "vitest run --coverage",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\" \"tests/**/*.js\""
  },
  "dependencies": {
    "@node-rs/bcrypt": "1.10.7",
    "cookie-parser": "1.4.7",
    "express": "5.1.0",
    "express-rate-limit": "7.5.0",
    "helmet": "8.1.0",
    "node-cron": "3.0.3",
    "pg": "8.13.1",
    "pino": "9.6.0",
    "pino-http": "10.4.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "2.1.8",
    "dotenv": "16.4.7",
    "eslint": "9.17.0",
    "eslint-config-prettier": "9.1.0",
    "node-pg-migrate": "7.9.0",
    "pino-pretty": "13.0.0",
    "prettier": "3.4.2",
    "supertest": "7.0.0",
    "vitest": "2.1.8"
  }
}
